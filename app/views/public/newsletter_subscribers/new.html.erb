<% content_for :title, "Newsletter-Anmeldung | StuttgartLIVE" %>
<h1>StuttgartLIVE-Newsletter</h1>
<%= form_with model: @subscriber, url: newsletter_subscribers_path, method: :post, class: "newsletter-consent-form", data: { turbo: false } do |form| %>
  <%= hidden_field_tag :source, params[:source].presence || "newsletter" %>
  <%= hidden_field_tag :return_to, new_newsletter_subscriber_path %>
  <% if @subscriber.errors.any? %>
    <div role="alert" class="newsletter-consent-feedback"><%= @subscriber.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="newsletter-consent-email">
    <%= form.label :email, "E-Mail-Adresse" %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
  </div>
  <%= render "public/newsletter_subscribers/consents", form:, prefix: "newsletter-signup" %>
  <%= form.submit "Newsletter abonnieren" %>
  <p class="newsletter-consent-note"><%= Newsletter::ConsentText::FOOTER %></p>
  <%= link_to "Datenschutzerklärung", datenschutz_path %>
<% end %>
