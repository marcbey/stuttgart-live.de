<% content_for :title, "#{@page.title} | Stuttgart Live" %>

<%= render "public/pages/info_page",
           kicker: @page.kicker.presence || "Service",
           title: @page.title,
           intro: @page.intro.to_s,
           page_slug: @page.slug,
           admin_link_path: (authenticated? && current_user.backend_access? ? edit_backend_page_path(@page) : nil) do %>
  <% if @page.card_layout? %>
    <%= @page.body %>
  <% else %>
    <article class="static-page-article">
      <div class="static-page-rich-copy">
        <%= @page.body %>
      </div>
    </article>
  <% end %>
<% end %>
