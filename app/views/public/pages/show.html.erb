<%= render_public_seo title: "#{@page.title} | Stuttgart Live",
                      meta_title: @page.title,
                      description: public_static_page_description(@page),
                      canonical_url: static_page_url(@page.slug) %>

<%= render "public/pages/info_page",
           kicker: @page.kicker.presence,
           title: @page.title,
           intro: @page.intro.to_s,
           page_slug: @page.slug,
           admin_link_path: (authenticated? && current_user.backend_access? ? edit_backend_page_path(@page) : nil) do %>
  <% if @page.slug == "kontakt" && !@page.body.body.to_html.include?("contact-mail-form") %>
    <%= render "public/pages/contact_form" %>
  <% end %>

  <% if @page.card_layout? %>
    <%= @page.body %>
  <% else %>
    <article class="static-page-article">
      <div class="static-page-rich-copy">
        <%= @page.body %>
      </div>
    </article>
  <% end %>
<% end %>
