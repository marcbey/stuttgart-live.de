<div class="event-detail-header-panel news-detail-header-panel">
  <div class="event-detail-header-copy">
    <div class="event-detail-header-intro">
      <div class="news-detail-meta-author-row">
        <% if presenter.meta_line.present? %>
          <p class="event-detail-meta-line"><%= presenter.meta_line %></p>
        <% end %>
        <div class="news-detail-author">
          <span class="news-detail-author-avatar" aria-hidden="true">
            <% if presenter.author_image_source.present? %>
              <%= image_tag presenter.author_image_source, alt: "" %>
            <% else %>
              <%= presenter.author_initials %>
            <% end %>
          </span>
          <span class="news-detail-author-copy">
            <span class="news-detail-author-name"><%= presenter.author_label %></span>
            <span class="news-detail-author-role"><%= presenter.author_role %></span>
          </span>
        </div>
      </div>
      <h1><%= presenter.headline %></h1>
      <% if presenter.teaser.present? %>
        <p class="event-detail-title"><%= presenter.teaser %></p>
      <% end %>
    </div>
  </div>
</div>
