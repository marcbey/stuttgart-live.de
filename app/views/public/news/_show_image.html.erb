<div class="event-detail-image-wrap news-detail-image-wrap">
  <div class="event-detail-image-figure">
    <div class="event-detail-image-stage-shell" data-controller="image-credit">
      <div class="event-detail-image-stage event-detail-image-stage-static" style="<%= presenter.hero_stage_style %>">
        <picture class="event-detail-image-picture" style="<%= presenter.hero_picture_style %>">
          <%= image_tag presenter.hero_image_source,
                        alt: presenter.hero_alt_text,
                        class: "event-detail-image",
                        style: presenter.hero_image_style %>
        </picture>
      </div>
      <% if presenter.hero_image_credit.present? %>
        <p class="event-detail-image-credit"><%= presenter.hero_image_credit %></p>
      <% end %>
    </div>
  </div>
</div>
