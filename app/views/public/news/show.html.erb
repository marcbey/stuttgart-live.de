<% presenter = public_news_show_presenter(@blog_post) %>
<%= render "show_meta", presenter: presenter %>

<article class="event-detail news-detail">
  <div class="event-detail-topbar">
    <p class="event-detail-back">
      <%= link_to presenter.back_path, aria: { label: "Zurück" } do %>
        <%= render "public/events/back_link_icon" %>
      <% end %>
    </p>
    <% if authenticated? && current_user.blog_access? %>
      <div class="event-detail-topbar-actions">
        <%= link_to "Edit",
                    edit_backend_blog_post_path(@blog_post),
                    class: "button button-secondary button-compact event-detail-edit-link public-edit-link",
                    data: { turbo: false } %>
      </div>
    <% end %>
  </div>

  <% if presenter.hero_image? %>
    <section class="news-detail-primary">
      <div class="news-detail-media-column">
        <%= render "show_image", presenter: presenter %>
      </div>

      <div class="news-detail-text-column">
        <%= render "show_header_copy", presenter: presenter %>

        <section class="event-detail-panel event-detail-copy event-detail-copy-primary news-detail-copy news-detail-body-copy">
          <%= presenter.body %>
        </section>
      </div>
    </section>
  <% else %>
    <%= render "show_hero", presenter: presenter %>

    <div class="event-detail-body">
      <div class="event-detail-main">
        <section class="event-detail-panel event-detail-copy event-detail-copy-primary news-detail-copy news-detail-body-copy">
          <%= presenter.body %>
        </section>
      </div>
    </div>
  <% end %>

  <div class="event-detail-body">
    <div class="event-detail-main">
      <% if presenter.has_video_block? %>
        <%= render "show_media", presenter: presenter %>
      <% end %>
    </div>
  </div>
</article>
