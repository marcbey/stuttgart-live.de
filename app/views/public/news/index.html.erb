<%= render_public_seo title: "Stuttgart Live - News",
                      description: "Aktuelle News, Konzertankündigungen und Vorverkäufe von Stuttgart Live.",
                      canonical_url: news_index_url %>
<section class="news-shell news-index-shell">
  <header class="news-hero news-index-hero">
    <div class="news-index-hero-bar" aria-hidden="true"></div>
    <h1>Aktuelle News</h1>
  </header>

  <% if @blog_posts.any? %>
    <div class="news-grid news-index-grid" id="news-index-grid">
      <%= render "public/news/cards", blog_posts: @blog_posts, include_newsletter: false %>
    </div>
    <%= render "public/news/more", has_more: @has_more_blog_posts, next_offset: @next_offset %>
  <% else %>
    <div class="empty-state">Keine passenden News gefunden.</div>
  <% end %>
</section>
