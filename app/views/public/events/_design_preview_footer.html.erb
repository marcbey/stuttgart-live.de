<% menu_groups = Array(local_assigns[:menu_groups]) %>

<footer class="design-preview-footer">
  <div class="design-preview-footer-brand">
    <strong>Stuttgart<br>Live</strong>
    <p>Events in deiner Stadt.</p>
    <div class="design-preview-footer-socials" aria-label="Soziale Medien">
      <%= link_to "https://www.instagram.com/stuttgart.live.concert/",
                  class: "design-preview-footer-social-link",
                  target: "_blank",
                  rel: "noopener",
                  title: "Instagram",
                  aria: { label: "Instagram" } do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="4.5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.4" cy="6.7" r="1.2" class="design-preview-footer-social-fill"></circle>
        </svg>
      <% end %>
      <%= link_to "https://www.tiktok.com/@stuttgart.live.concert",
                  class: "design-preview-footer-social-link",
                  target: "_blank",
                  rel: "noopener",
                  title: "TikTok",
                  aria: { label: "TikTok" } do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M14.2 4.2c.36 1.82 1.44 3.18 3.26 4.06.63.3 1.3.48 2.04.55v2.56a8.18 8.18 0 0 1-3.01-.67v5.06c0 3.1-2.48 5.53-5.74 5.53-3.05 0-5.56-2.3-5.56-5.27 0-3.1 2.72-5.5 5.91-5.22v2.66a2.67 2.67 0 0 0-3.21 2.56c0 1.47 1.2 2.66 2.72 2.66 1.66 0 2.74-1.26 2.74-3.02V4.2h2.85Z" class="design-preview-footer-social-fill"></path>
        </svg>
      <% end %>
      <%= link_to "https://www.facebook.com/stuttgartlive",
                  class: "design-preview-footer-social-link",
                  target: "_blank",
                  rel: "noopener",
                  title: "Facebook",
                  aria: { label: "Facebook" } do %>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M13.4 20.5v-7h2.3l.35-2.75H13.4V9c0-.8.22-1.35 1.37-1.35h1.46V5.2c-.25-.03-1.1-.1-2.1-.1-2.08 0-3.5 1.27-3.5 3.62v2.03H8.3v2.75h2.37v7h2.73Z" class="design-preview-footer-social-fill"></path>
        </svg>
      <% end %>
    </div>
  </div>
  <nav class="design-preview-footer-nav" aria-label="Footer Navigation">
    <% menu_groups.each do |group_label, links| %>
      <section class="design-preview-footer-nav-group" aria-labelledby="design-preview-footer-<%= group_label.parameterize %>">
        <h2 id="design-preview-footer-<%= group_label.parameterize %>"><%= group_label %></h2>
        <div>
          <% links.each do |label, path| %>
            <%= link_to label, path %>
          <% end %>
        </div>
      </section>
    <% end %>
  </nav>
  <section id="design-preview-newsletter" class="design-preview-footer-newsletter" aria-labelledby="design-preview-footer-newsletter-title">
    <p>Newsletter</p>
    <h2 id="design-preview-footer-newsletter-title">Nichts verpassen.</h2>
    <span>Neue Events direkt per Mail.</span>
    <%= form_with model: NewsletterSubscriber.new,
                  url: newsletter_subscribers_path(context: "events_index", return_to: request.fullpath, source: "footer"),
                  local: true,
                  class: "design-preview-footer-newsletter-form" do |form| %>
      <%= form.email_field :email,
                           placeholder: "E-Mail-Adresse",
                           autocomplete: "email",
                           aria: { label: "E-Mail-Adresse für Newsletter" } %>
      <%= form.submit "Anmelden" %>
    <% end %>
  </section>
  <div class="design-preview-footer-partners">
    <%= render "public/events/partner_strip" %>
  </div>
</footer>
