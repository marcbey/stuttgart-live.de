<%
  grid_classes = [ "lane-page-grid", "design-preview-list-card-grid", ("featured-event-grid" if lane.key == "highlights") ].compact
  lane_key_class = "lane-page-section--#{lane.key.tr("_", "-")}"
  strict_proxy = local_assigns.fetch(:strict_proxy, false)
  lazy_lane_id = local_assigns[:lazy_lane_id]
  lazy_url = local_assigns[:lazy_url]
  lazy_next_cursor = local_assigns[:lazy_next_cursor]
  lazy_per_page = local_assigns.fetch(:lazy_per_page, Public::EventsController::LANE_PAGE_LIMIT)
  display_title = local_assigns[:title].presence || lane.title
%>

<section class="design-preview-section design-preview-list-section lane-page-section <%= lane_key_class %> search-results-section"
         <% if lazy_lane_id.present? %>data-controller="lane-page"<% end %>
         <% if lazy_lane_id.present? %>
         data-lane-page-url-value="<%= lazy_url %>"
         data-lane-page-lane-value="<%= lazy_lane_id %>"
         data-lane-page-cursor-value="<%= lazy_next_cursor %>"
         data-lane-page-per-page-value="<%= lazy_per_page %>"
         <% end %>>
  <div class="design-preview-section-header">
    <% if lane.key == "russ_live" %>
      <h2 class="lane-page-russ-live-logo-title">
        <%= image_tag "russ-live-logo.svg",
                      alt: display_title,
                      class: "lane-page-russ-live-logo",
                      width: 786,
                      height: 174 %>
      </h2>
    <% else %>
      <h2><%= display_title %></h2>
    <% end %>
  </div>
  <% if events.any? %>
    <div class="<%= grid_classes.join(" ") %>"
         id="lane-event-grid"
         <% if lazy_lane_id.present? %>data-lane-page-target="grid"<% end %>>
      <%= render "design_preview_event_grid",
                 events: events,
                 browse_state: browse_state,
                 effective_series_ids: effective_series_ids,
                 strict_proxy: strict_proxy,
                 show_card_kicker: lane.key != "genre",
                 show_admin_edit: %w[highlights russ_live].include?(lane.key) %>
    </div>
    <% if lazy_lane_id.present? %>
      <div class="pagination-sentinel lane-page-pagination" data-lane-page-target="pagination">
        <button type="button"
                class="button button-secondary button-compact pagination-link"
                data-action="click->lane-page#load"
                data-lane-page-target="button"
                aria-controls="lane-event-grid">
          Mehr Events laden
        </button>
        <p class="pagination-copy" data-lane-page-target="status" aria-live="polite"></p>
      </div>
    <% end %>
  <% else %>
    <div class="search-results-empty">
      <h2>Aktuell nichts in dieser Lane</h2>
      <p>Für „<%= lane.title %>“ haben wir aktuell keine zukünftigen Events.</p>
    </div>
  <% end %>
</section>
