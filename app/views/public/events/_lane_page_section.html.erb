<%
  featured_grid = lane.featured
  grid_classes = [ "lane-page-grid" ]
  grid_classes << "featured-event-grid" if featured_grid
  strict_proxy = local_assigns.fetch(:strict_proxy, false)
  lazy_lane_id = local_assigns[:lazy_lane_id]
  lazy_url = local_assigns[:lazy_url]
  lazy_next_cursor = local_assigns[:lazy_next_cursor]
  lazy_list_next_cursor = local_assigns[:lazy_list_next_cursor].presence || lazy_next_cursor
  lazy_per_page = local_assigns.fetch(:lazy_per_page, Public::EventsController::LANE_PAGE_LIMIT)
  section_controllers = [ "section-view", ("lane-page" if lazy_lane_id.present?) ].compact
  nav_content = capture do
%>
  <button type="button"
          class="slider-view-toggle"
          data-section-view-target="button"
          data-action="click->section-view#toggle"
          title="Listenansicht"
          aria-label="Listenansicht für <%= lane.title %>"
          aria-pressed="false">
    <span class="slider-view-toggle-label" data-section-view-target="label">Listenansicht</span>
    <span class="slider-view-icon slider-view-icon-list public-view-icon public-view-icon-list" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="slider-view-icon slider-view-icon-grid public-view-icon public-view-icon-grid" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </span>
  </button>
<% end %>

<section class="home-slider-section lane-page-section <%= "lane-page-section--compact-grid" unless featured_grid %> search-results-section <%= "lane-page-section--featured-grid" if featured_grid %>"
         data-controller="<%= section_controllers.join(" ") %>"
         data-section-view-mobile-list-default-value="true"
         <% if lazy_lane_id.present? %>
         data-lane-page-url-value="<%= lazy_url %>"
         data-lane-page-lane-value="<%= lazy_lane_id %>"
         data-lane-page-cursor-value="<%= lazy_next_cursor %>"
         data-lane-page-list-cursor-value="<%= lazy_list_next_cursor %>"
         data-lane-page-per-page-value="<%= lazy_per_page %>"
         <% end %>>
  <%= render "home_slider_header",
             title: lane.title,
             variant: lane.header_variant,
             nav_content: nav_content %>
  <% if events.any? %>
    <div data-section-view-target="slider">
      <div class="<%= grid_classes.join(" ") %>"
           id="lane-event-grid"
           <% if lazy_lane_id.present? %>data-lane-page-target="grid"<% end %>>
        <% if featured_grid %>
          <%= render "event_cards",
                     events: events,
                     browse_state: browse_state,
                     effective_series_ids: effective_series_ids,
                     series_counts_by_id: local_assigns[:series_counts_by_id],
                     strict_proxy: strict_proxy,
                     container_id: "lane-event-grid",
                     card_dom_id_prefix: :lane_page_card,
                     wrap: false %>
        <% else %>
          <% events.each do |event| %>
            <%= render "genre_lane_card",
                       event: event,
                       browse_state: browse_state,
                       effective_series_ids: effective_series_ids,
                       series_counts_by_id: local_assigns[:series_counts_by_id],
                       card_dom_id: dom_id(event, :lane_page_card) %>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="section-slider-list genre-lane-list"
         data-section-view-target="list"
         <% if lazy_lane_id.present? %>data-lane-page-target="list"<% end %>
         hidden>
      <%= render "event_rows",
                 events: events,
                 browse_state: browse_state,
                 effective_series_ids: effective_series_ids,
                 series_counts_by_id: local_assigns[:series_counts_by_id],
                 row_dom_id_prefix: :lane_page_row %>
    </div>
    <% if lazy_lane_id.present? %>
      <div class="pagination-sentinel lane-page-pagination" data-lane-page-target="pagination">
        <button type="button"
                class="button button-secondary button-compact pagination-link"
                data-action="click->lane-page#load"
                data-lane-page-target="button"
                aria-controls="lane-event-grid">
          Mehr Events laden
        </button>
        <p class="pagination-copy" data-lane-page-target="status" aria-live="polite"></p>
      </div>
    <% end %>
  <% else %>
    <div class="search-results-empty">
      <h2>Aktuell nichts in dieser Lane</h2>
      <p>Für „<%= lane.title %>“ haben wir aktuell keine zukünftigen Events.</p>
    </div>
  <% end %>
</section>
