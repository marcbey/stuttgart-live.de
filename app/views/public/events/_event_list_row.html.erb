<% browse_state = local_assigns.fetch(:browse_state) %>
<% strict_proxy = local_assigns.fetch(:strict_proxy, false) %>
<% thumbnail_image = event.image_for(slot: :grid_default, breakpoint: :mobile) || event.image_for(slot: :grid_default, breakpoint: :desktop) %>
<% thumbnail_source = event_image_source(thumbnail_image, strict_proxy: strict_proxy, size: :thumbnail) %>
<% thumbnail_srcset = event_image_srcset(thumbnail_image, variant_sizes: %i[thumbnail card_mobile], strict_proxy: strict_proxy) %>
<% thumbnail_dimensions = public_event_listing_thumbnail_dimensions %>
<% event_url = public_event_detail_path(event, browse_state) %>
<% primary_offer = event.public_ticket_offer %>
<% row_dom_id = local_assigns[:row_dom_id] %>
<% display_price = public_event_ticket_price(event, primary_offer) %>
<% unavailable_label = event.public_ticket_status_label %>
<% show_series_pill = public_event_series_effective?(event, effective_series_ids: local_assigns[:effective_series_ids]) %>
<% show_price_row = display_price.present? || unavailable_label.present? || show_series_pill %>
<% article_classes = ["event-listing-card", ("event-listing-card--admin" if authenticated?)].compact %>
<% article_attributes = { class: article_classes.join(" ") } %>
<% article_attributes[:id] = row_dom_id if row_dom_id.present? %>

<article <%= tag.attributes(article_attributes) %>>
  <%= link_to event_url, class: "event-listing-row-link", aria: { label: "#{event.artist_name} anzeigen" } do %>
    <span class="sr-only"><%= [event.artist_name, event.title].compact.join(" - ") %></span>
  <% end %>

  <div class="event-listing-thumb-link">
    <% if thumbnail_source.present? %>
      <%= image_tag thumbnail_source,
                    alt: event_image_alt(thumbnail_image, event),
                    loading: "lazy",
                    decoding: "async",
                    class: "event-listing-thumb-image",
                    width: thumbnail_dimensions.fetch(:width),
                    height: thumbnail_dimensions.fetch(:height),
                    srcset: thumbnail_srcset,
                    sizes: "4.4rem" %>
    <% else %>
      <div class="event-listing-thumb-image event-card-placeholder" aria-hidden="true"></div>
    <% end %>
  </div>

  <div class="event-listing-body">
    <div class="event-listing-meta">
      <div class="event-listing-meta-primary">
        <p class="event-listing-date">
          <span class="event-listing-date-value"><%= l(event.start_at.to_date, format: "%d.%m.%Y") %></span>
          <% if event.venue.present? %>
            <span class="event-listing-venue"><%= event.venue %></span>
          <% end %>
        </p>
      </div>
    </div>
    <div class="event-listing-link">
      <strong><%= event.artist_name %></strong>
      <% if event.title.present? %>
        <span><%= event.title %></span>
      <% end %>
    </div>
    <% if show_price_row %>
      <div class="event-listing-price-row">
        <% if display_price.present? %>
          <p class="event-listing-price"><%= display_price %></p>
        <% end %>
        <% if unavailable_label.present? %>
          <span class="event-listing-status-pill"><%= unavailable_label %></span>
        <% end %>
        <% if show_series_pill %>
          <span class="event-listing-series-pill" aria-label="Event-Reihe">
            <%= image_tag "event-series-icon.svg", class: "event-listing-series-pill-icon", alt: "" %>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if authenticated? %>
    <div class="event-card-admin-controls event-listing-admin-controls">
      <%= link_to "Edit",
                  backend_events_path(status: event.status, event_id: event.id),
                  class: "event-card-admin-link event-card-admin-link-attention",
                  data: { turbo: false } %>

      <% if event.primary_source.present? %>
        <span class="status-badge event-card-admin-link"><%= event_source_label(event.primary_source) %></span>
      <% end %>
    </div>
  <% end %>
</article>
