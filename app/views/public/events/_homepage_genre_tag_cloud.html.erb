<% tags = Array(local_assigns[:tags]) %>

<% if tags.any? %>
  <section class="homepage-genre-tag-cloud" aria-label="Weitere Genres">
    <nav class="homepage-genre-tag-cloud-tags" aria-label="Weitere Genres">
      <% tags.each do |tag| %>
        <%= link_to tag.name,
                    tag.public_path,
                    class: "homepage-genre-tag-cloud-tag",
                    aria: { label: "#{tag.name}, #{pluralize(tag.upcoming_events_count, "kommendes Event", "kommende Events")}" } %>
      <% end %>
    </nav>
  </section>
<% end %>
