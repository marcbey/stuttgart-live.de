<%
  result_count = events.size
  result_label = result_count == 1 ? "1 Ergebnis" : "#{result_count} Ergebnisse"
  search_meta = "Deine Suche nach „#{browse_state.query}“ ergab #{result_label}"
  effective_series_ids = effective_public_event_series_ids(events)
  strict_proxy = local_assigns.fetch(:strict_proxy, false)
%>

<section class="design-preview-section design-preview-list-section lane-page-section search-results-section">
  <div class="design-preview-section-header design-preview-section-header--stacked">
    <div>
      <h2>Suchergebnisse</h2>
      <p class="design-preview-list-meta"><%= search_meta %></p>
    </div>
  </div>
  <% if events.any? %>
    <div class="lane-page-grid design-preview-list-card-grid" id="event-grid">
      <%= render "design_preview_event_grid",
                 events: events,
                 browse_state: browse_state,
                 effective_series_ids: effective_series_ids,
                 strict_proxy: strict_proxy %>
    </div>
  <% else %>
    <div class="search-results-empty">
      <h2>Sorry, nix gefunden</h2>
      <p>Zu „<%= browse_state.query %>“ haben wir aktuell keine Events gefunden.</p>
    </div>
  <% end %>
</section>
