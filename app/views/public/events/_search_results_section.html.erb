<%
  result_count = local_assigns.fetch(:result_count, events.size)
  result_label = result_count == 1 ? "1 Ergebnis" : "#{result_count} Ergebnisse"
  search_meta = "Deine Suche nach „#{browse_state.query}“ ergab #{result_label}"
  effective_series_ids = local_assigns.fetch(:effective_series_ids) { effective_public_event_series_ids(events) }
  series_counts_by_id = local_assigns.fetch(:series_counts_by_id, {})
  lazy_next_cursor = local_assigns[:lazy_next_cursor]
  lazy_url = local_assigns[:lazy_url]
  strict_proxy = local_assigns.fetch(:strict_proxy, false)
%>

<section class="design-preview-section design-preview-list-section lane-page-section search-results-section"
         <% if lazy_next_cursor.present? %>
         data-controller="lane-page"
         data-lane-page-url-value="<%= lazy_url %>"
         data-lane-page-lane-value="search"
         data-lane-page-cursor-value="<%= lazy_next_cursor %>"
         <% end %>>
  <header class="search-results-header">
    <div>
      <h1 class="search-results-title">Suchergebnisse</h1>
      <p class="design-preview-list-meta lane-header-meta"><%= search_meta %></p>
    </div>
  </header>
  <% if events.any? %>
    <div class="lane-page-grid design-preview-list-card-grid" id="event-grid" data-lane-page-target="grid">
      <%= render "design_preview_event_grid",
                 events: events,
                 browse_state: browse_state,
                 effective_series_ids: effective_series_ids,
                 series_counts_by_id: series_counts_by_id,
                 dom_id_prefix: "search_card_event",
                 show_admin_edit: true,
                 strict_proxy: strict_proxy %>
    </div>
    <% if lazy_next_cursor.present? %>
      <div class="pagination-sentinel lane-page-pagination" data-lane-page-target="pagination">
        <button type="button"
                class="button button-secondary button-compact pagination-link"
                data-action="click->lane-page#load"
                data-lane-page-target="button"
                aria-controls="event-grid">Mehr Events laden</button>
        <p class="pagination-copy" data-lane-page-target="status" aria-live="polite"></p>
      </div>
    <% end %>
  <% else %>
    <div class="search-results-empty">
      <h2>Sorry, nix gefunden</h2>
      <p>Zu „<%= browse_state.query %>“ haben wir aktuell keine Events gefunden.</p>
      <%= render "public/events/search_recovery" %>
    </div>
  <% end %>
</section>
