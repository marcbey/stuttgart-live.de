<% playlist = public_homepage_highlight_playlist(
  events: local_assigns[:events] || [local_assigns[:event]].compact,
  browse_state: browse_state,
  setting: local_assigns[:setting] || AppSetting.homepage_highlight_video_record,
  strict_proxy: local_assigns.fetch(:strict_proxy, false),
  fallback_video: local_assigns[:fallback_video],
  fallback_poster: local_assigns[:fallback_poster],
  fallback_href: local_assigns[:fallback_href]
) %>
<%= render "public/events/video_playlist_card", playlist: playlist,
           media: "(min-width: 80rem)", storage_key: "homepage-portrait" %>
