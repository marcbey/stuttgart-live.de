<%= render_public_seo title: "Stuttgart Live - Deine Events",
                      description: "Deine gemerkten Events bei Stuttgart Live.",
                      canonical_url: saved_events_url,
                      robots: "noindex, follow" %>
<% content_for :page_newsletter do %><% end %>
<% content_for :page_partner_strip do %><% end %>
<% strict_proxy = homepage_media_strict_proxy? %>
<% genre_lanes = public_design_navigation_lanes(Array(@design_chrome_genre_lanes).first(5), highlight_events: @home_featured_events) %>
<% design_chrome_saved_events = Array(@design_chrome_saved_events).compact.uniq(&:id) %>

<div class="design-preview design-preview-list-shell"
     data-controller="design-preview-menu design-preview-filterbar">
  <%= render "design_preview_header",
             browse_state: @browse_state,
             genre_lanes: genre_lanes,
             search_overlay: @design_preview_search_overlay,
             menu_groups: public_design_menu_groups,
             saved_events: design_chrome_saved_events,
             strict_proxy: strict_proxy %>

  <main class="design-preview-list-page">
    <%= link_to public_events_index_path(@browse_state),
                class: "design-detail-preview-back",
                aria: { label: "Zurück" },
                data: { controller: "history-back-link", action: "click->history-back-link#navigate" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H6"></path>
        <path d="m11 6-6 6 6 6"></path>
      </svg>
      Zurück
    <% end %>

    <section class="saved-events-page-section"
             data-controller="saved-events-lane"
             data-saved-events-lane-url-value="<%= saved_lane_events_path %>"
             data-saved-events-lane-show-empty-value="true"
             data-saved-events-lane-empty-title-value="Du hast noch keine Events gemerkt."
             data-saved-events-lane-empty-message-value="Tippe bei einem Event auf das Herz, dann findest du es hier wieder."
             data-saved-events-lane-unavailable-title-value="Deine gemerkten Events sind aktuell nicht mehr verfügbar."
             data-saved-events-lane-unavailable-message-value="Manche Termine sind vielleicht vorbei oder nicht mehr öffentlich sichtbar.">
      <noscript>
        <div class="search-results-empty saved-events-empty">
          <h2>Deine Events</h2>
          <p>Gemerkte Events werden in diesem Browser gespeichert. Bitte aktiviere JavaScript, damit wir sie hier anzeigen können.</p>
        </div>
      </noscript>
    </section>
  </main>

  <%= render "design_preview_footer", menu_groups: public_design_menu_groups %>
</div>
