<% group = local_assigns[:group] %>
<% title = local_assigns[:title] || group&.name %>
<% kicker = local_assigns[:kicker] %>
<% section_variant = local_assigns[:section_variant] %>
<% card_variant = local_assigns[:card_variant] %>
<% effective_series_ids = local_assigns[:effective_series_ids] || effective_public_event_series_ids(events) %>
<% series_counts_by_id = local_assigns[:series_counts_by_id] || {} %>
<% show_series_badge = local_assigns.fetch(:show_series_badge, true) %>
<% hover_lift_cards = local_assigns.fetch(:hover_lift_cards, false) %>
<% header_variant = local_assigns.fetch(:header_variant, :genre) %>
<% strict_proxy = local_assigns.fetch(:strict_proxy, false) %>
<% tone_class = local_assigns.fetch(:tone_class, "genre-lane-section--tone-1") %>
<% lazy_lane_id = local_assigns[:lazy_lane_id] %>
<% lazy_next_cursor = local_assigns[:lazy_next_cursor] %>
<% lazy_url = local_assigns[:lazy_url] %>
<% defer_initial_page = local_assigns.fetch(:defer_initial_page, false) %>
<% rendered_events = defer_initial_page ? [] : events %>
<% section_lazy_next_cursor = defer_initial_page ? nil : lazy_next_cursor %>
<% section_cache_key = public_events_section_cache_key(
  section: "genre-lane",
  browse_state: browse_state,
  events: events,
  context: [
    title,
    group&.slug,
    local_assigns[:title_url],
    kicker,
    section_variant,
    card_variant,
    show_series_badge,
    hover_lift_cards,
    header_variant,
    local_assigns[:header_class],
    tone_class,
    list_aria_label,
    lazy_lane_id,
    lazy_next_cursor,
    lazy_url,
    defer_initial_page
  ],
  strict_proxy: strict_proxy
) %>
<% nav_content = capture do %>
  <button type="button"
          class="slider-view-toggle"
          data-section-view-target="button"
          data-action="click->section-view#toggle"
          title="Listenansicht"
          aria-label="<%= list_aria_label %>"
          aria-pressed="false">
    <span class="slider-view-toggle-label" data-section-view-target="label">Listenansicht</span>
    <span class="slider-view-icon slider-view-icon-list public-view-icon public-view-icon-list" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="slider-view-icon slider-view-icon-grid public-view-icon public-view-icon-grid" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </span>
  </button>
<% end %>

<% cache section_cache_key do %>
  <section class="<%= ["genre-lane-section", tone_class, ("genre-lane-section--#{section_variant}" if section_variant.present?), ("genre-lane-section--hover-lift" if hover_lift_cards)].compact.join(" ") %>"
           data-controller="<%= ["highlights-slider", "section-view", ("homepage-lane" if lazy_lane_id.present?)].compact.join(" ") %>"
           <% if lazy_lane_id.present? %>
           data-homepage-lane-url-value="<%= lazy_url %>"
           data-homepage-lane-lane-value="<%= lazy_lane_id %>"
           data-homepage-lane-cursor-value="<%= section_lazy_next_cursor %>"
           data-homepage-lane-list-cursor-value="<%= section_lazy_next_cursor %>"
           data-homepage-lane-per-page-value="<%= Public::EventsController::HOME_LANE_LIMIT %>"
           data-homepage-lane-list-limit-value="<%= Public::EventsController::HOME_LANE_LIST_LIMIT %>"
           <% if defer_initial_page %>data-homepage-lane-deferred-value="true"<% end %>
           <% end %>>
    <%= render "home_slider_header",
               title: title,
               title_url: local_assigns[:title_url],
               kicker: kicker,
               variant: header_variant,
               header_class: local_assigns[:header_class],
               nav_content: nav_content %>

    <div data-section-view-target="slider">
      <div class="highlights-slider-viewport">
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-prev genre-lane-arrow"
                data-highlights-slider-target="previousButton"
                data-action="click->highlights-slider#previous"
                aria-label="Zurück">
          ‹
        </button>
        <div class="genre-lane-track"
             data-highlights-slider-target="track"
             <% if lazy_lane_id.present? %>data-homepage-lane-target="track"<% end %>>
          <% if defer_initial_page %>
            <% 4.times do %>
              <article class="genre-lane-card homepage-lane-placeholder homepage-lane-initial-placeholder" aria-hidden="true"></article>
            <% end %>
          <% end %>
          <% rendered_events.each do |event| %>
            <%= render "genre_lane_card",
                       event: event,
                       browse_state: browse_state,
                       card_variant: card_variant,
                       strict_proxy: strict_proxy,
                       effective_series_ids: effective_series_ids,
                       series_counts_by_id: series_counts_by_id,
                       show_series_badge: show_series_badge %>
          <% end %>
        </div>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-next genre-lane-arrow"
                data-highlights-slider-target="nextButton"
                data-action="click->highlights-slider#next"
                aria-label="Weiter">
          ›
        </button>
      </div>
    </div>

    <div class="section-slider-list-viewport"
         data-section-view-target="list"
         hidden>
      <% if lazy_lane_id.present? %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-prev section-slider-list-arrow"
                data-action="click->homepage-lane#previousList"
                aria-label="Zurück">
          ‹
        </button>
      <% end %>
      <div class="section-slider-list genre-lane-list"
           <% if lazy_lane_id.present? %>data-homepage-lane-target="list"<% end %>>
        <%= render "event_rows",
                   events: rendered_events,
                   browse_state: browse_state,
                   effective_series_ids: effective_series_ids,
                   series_counts_by_id: series_counts_by_id,
                   strict_proxy: strict_proxy %>
      </div>
      <% if lazy_lane_id.present? %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-next section-slider-list-arrow"
                data-action="click->homepage-lane#nextList"
                aria-label="Weiter">
          ›
        </button>
      <% end %>
    </div>
  </section>
<% end %>
