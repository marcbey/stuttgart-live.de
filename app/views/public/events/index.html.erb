<% content_for :title, "Stuttgart Live - Konzerte" %>
<% content_for :page_newsletter do %>
  <%= render "newsletter_signup", browse_state: @browse_state %>
<% end %>
<% content_for :page_partner_strip do %>
  <%= render "partner_strip" %>
<% end %>

<section class="public-shell">
  <% strict_proxy = homepage_media_strict_proxy? %>
  <% promotion_banners_by_lane_position = @promotion_banners_by_lane_position || {} %>
  <% promotion_banner_lane_position = 1 %>

  <% if @browse_state.page == 1 && @home_featured_events.present? %>
    <%= render "promotion_banners",
               banners: promotion_banners_by_lane_position[promotion_banner_lane_position],
               browse_state: @browse_state,
               strict_proxy: strict_proxy %>
    <% promotion_banner_lane_position += 1 %>

    <%= render "highlight_section",
               title: "Unsere Highlights",
               title_url: @home_featured_lane&.public_path,
               events: @home_featured_events,
               effective_series_ids: @home_featured_effective_series_ids,
               browse_state: @browse_state,
               strict_proxy: strict_proxy,
               featured: true,
               list_aria_label: "Listenansicht für Highlights" %>
  <% end %>
  <% if @browse_state.page == 1 %>
    <% genre_lanes = Array(@home_genre_lanes) %>

    <% if genre_lanes.first.present? %>
      <%= render "promotion_banners",
                 banners: promotion_banners_by_lane_position[promotion_banner_lane_position],
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy %>
      <% promotion_banner_lane_position += 1 %>

      <%= render "genre_lane_section",
                 group: genre_lanes.first.group,
                 title_url: genre_lanes.first.public_path,
                 events: genre_lanes.first.events,
                 effective_series_ids: genre_lanes.first.effective_series_ids,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 header_variant: :genre,
                 hover_lift_cards: true,
                 tone_class: "genre-lane-section--tone-1",
                 list_aria_label: "Listenansicht für #{genre_lanes.first.group.name}" %>
    <% end %>

    <% if @home_tagestipp_events.present? %>
      <%= render "promotion_banners",
                 banners: promotion_banners_by_lane_position[promotion_banner_lane_position],
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy %>
      <% promotion_banner_lane_position += 1 %>

      <%= render "genre_lane_section",
                 title: "Tagestipp",
                 title_url: @home_tagestipp_lane&.public_path,
                 events: @home_tagestipp_events,
                 effective_series_ids: @home_tagestipp_effective_series_ids,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 header_variant: :tagestipp,
                 hover_lift_cards: true,
                 summary: "#{pluralize(@home_tagestipp_events.size, "Event", "Events")} in der heutigen Auswahl",
                 tone_class: "genre-lane-section--tone-3",
                 section_variant: "spotlight",
                 card_variant: "spotlight",
                 list_aria_label: "Listenansicht für Tagestipp" %>
    <% end %>

    <% if @home_highlight_events.present? %>
      <%= render "promotion_banners",
                 banners: promotion_banners_by_lane_position[promotion_banner_lane_position],
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy %>
      <% promotion_banner_lane_position += 1 %>

      <%= render "genre_lane_section",
                 title: "alles aus stuttgart",
                 title_url: @home_all_stuttgart_lane&.public_path,
                 events: @home_highlight_events,
                 effective_series_ids: @home_highlight_effective_series_ids,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 header_variant: :editorial,
                 hover_lift_cards: true,
                 summary: "#{pluralize(@home_highlight_events.size, "Event", "Events")} aus dem aktuellen Feed",
                 tone_class: "genre-lane-section--tone-2",
                 section_variant: "editorial",
                 card_variant: "editorial",
                 list_aria_label: "Listenansicht für alles aus stuttgart" %>
    <% end %>

    <% genre_lanes.drop(1).each_with_index do |lane, index| %>
      <%= render "promotion_banners",
                 banners: promotion_banners_by_lane_position[promotion_banner_lane_position],
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy %>
      <% promotion_banner_lane_position += 1 %>

      <%= render "genre_lane_section",
                 group: lane.group,
                 title_url: lane.public_path,
                 events: lane.events,
                 effective_series_ids: lane.effective_series_ids,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 header_variant: :genre,
                 hover_lift_cards: true,
                 tone_class: "genre-lane-section--tone-#{((index + 1) % 4) + 1}",
                 list_aria_label: "Listenansicht für #{lane.group.name}" %>
    <% end %>

    <%= render "homepage_genre_tag_cloud", tags: @home_genre_tag_cloud_genres %>

    <% trailing_promotion_banners = promotion_banners_by_lane_position.select { |position, _banners| position >= promotion_banner_lane_position }.values.flatten %>
    <%= render "promotion_banners",
               banners: trailing_promotion_banners,
               browse_state: @browse_state,
               strict_proxy: strict_proxy %>

    <div id="saved-events-lane-slot"
         class="saved-events-lane-slot"
         data-controller="saved-events-lane"
         data-saved-events-lane-url-value="<%= saved_lane_events_path %>"
         hidden></div>
  <% end %>
</section>
