<% article_options = { class: article_classes } %>
<% article_options[:style] = article_style if article_style.present? %>

<%= content_tag :article, **article_options do %>
  <% image_options = {
    alt: image_alt,
    class: [ "promotion-banner-image", local_assigns[:image_classes] ].compact.join(" "),
    style: image_style
  } %>
  <% image_options[:loading] = local_assigns[:image_loading] if local_assigns[:image_loading].present? %>
  <% image_options[:fetchpriority] = local_assigns[:image_fetchpriority] if local_assigns[:image_fetchpriority].present? %>
  <% image_options[:decoding] = local_assigns[:image_decoding] if local_assigns[:image_decoding].present? %>
  <% image_options[:srcset] = local_assigns[:image_srcset] if local_assigns[:image_srcset].present? %>
  <% image_options[:sizes] = local_assigns[:image_sizes] if local_assigns[:image_sizes].present? %>
  <% image_options[:width] = local_assigns[:image_width] if local_assigns[:image_width].present? %>
  <% image_options[:height] = local_assigns[:image_height] if local_assigns[:image_height].present? %>
  <% show_meta = local_assigns[:kicker_date].present? || local_assigns[:kicker_location].present? %>
  <% meta_after_subheading = local_assigns.fetch(:meta_after_subheading, false) %>

  <% if admin_link_path.present? %>
    <div class="promotion-banner-admin-controls">
      <%= link_to admin_link_label,
                  admin_link_path,
                  class: "event-card-admin-link event-card-admin-link-attention",
                  data: { turbo: false } %>
    </div>
  <% end %>

  <%= link_to href, class: link_classes, style: link_style do %>
    <div class="promotion-banner-visual">
      <div class="promotion-banner-media">
        <% if image_source.present? %>
          <%= image_tag image_source, **image_options %>
        <% else %>
          <div class="promotion-banner-image event-card-placeholder" aria-hidden="true"></div>
        <% end %>
      </div>
      <% if credit.present? %>
        <p class="promotion-banner-credit"><%= credit %></p>
      <% end %>
    </div>

    <div class="promotion-banner-copy">
      <% if show_meta && !meta_after_subheading %>
        <p class="promotion-banner-kicker promotion-banner-kicker-meta">
          <% if local_assigns[:kicker_date].present? %>
            <strong><%= local_assigns[:kicker_date] %></strong>
          <% end %>
          <% if local_assigns[:kicker_location].present? %>
            <span><%= local_assigns[:kicker_location] %></span>
          <% end %>
        </p>
      <% elsif kicker_text.present? %>
        <p class="promotion-banner-kicker"><%= kicker_text %></p>
      <% end %>
      <h2><%= heading %></h2>
      <% if subheading.present? %>
        <p class="promotion-banner-event-title"><%= subheading %></p>
      <% end %>
      <% if show_meta && meta_after_subheading %>
        <p class="promotion-banner-kicker promotion-banner-kicker-meta">
          <% if local_assigns[:kicker_date].present? %>
            <strong><%= local_assigns[:kicker_date] %></strong>
          <% end %>
          <% if local_assigns[:kicker_location].present? %>
            <span><%= local_assigns[:kicker_location] %></span>
          <% end %>
        </p>
      <% end %>
      <% if cta_text.present? %>
        <% cta_options = { class: "promotion-banner-cta" } %>
        <% cta_options[:style] = local_assigns[:cta_style] if local_assigns[:cta_style].present? %>
        <%= content_tag :span, cta_text, **cta_options %>
      <% end %>
    </div>
  <% end %>
<% end %>
