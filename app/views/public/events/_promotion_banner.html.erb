<% strict_proxy = local_assigns.fetch(:strict_proxy, homepage_media_strict_proxy?) %>
<% image_priority = local_assigns.fetch(:image_priority, false) %>
<% slider = local_assigns.fetch(:slider, false) %>
<% article_classes = "promotion-banner promotion-banner-poster promotion-banner-news" %>
<% article_classes = "#{article_classes} promotion-banner-layout-reversed" if local_assigns[:layout_variant] == :reversed %>
<% image_dimensions = public_promotion_banner_image_dimensions %>
<% image_slot =
  if !slider && blog_post.promotion_banner_landscape_image.attached?
    :promotion_banner_landscape_image
  elsif blog_post.promotion_banner_image.attached?
    :promotion_banner_image
  else
    :promotion_banner_landscape_image
  end %>
<% banner_text_color_scheme = slider ? BlogPost::PROMOTION_BANNER_TEXT_COLOR_LIGHT : blog_post.promotion_banner_text_color_scheme %>
<% banner_cta_color = banner_text_color_scheme == BlogPost::PROMOTION_BANNER_TEXT_COLOR_LIGHT ? "#F8F8F8" : "#111111" %>
<% banner_cta_text_color = banner_text_color_scheme == BlogPost::PROMOTION_BANNER_TEXT_COLOR_LIGHT ? "#111111" : "#F8F8F8" %>

<%= render "public/events/promotion_banner_component",
           article_classes: article_classes,
           article_style: "--promotion-banner-background: #{blog_post.promotion_banner_background_color_value}; --promotion-banner-cta-color: #{banner_cta_color}; --promotion-banner-cta-text-color: #{banner_cta_text_color}",
           admin_link_path: (authenticated? && current_user.blog_access? ? edit_backend_blog_post_path(blog_post) : nil),
           admin_link_label: "Edit",
           href: news_path(blog_post.slug),
           link_classes: "promotion-banner-link promotion-banner-link-#{banner_text_color_scheme}",
           link_style: nil,
           image_source: optimized_blog_post_image_source(blog_post, image_slot, strict_proxy: strict_proxy, size: :banner_desktop),
           image_srcset: optimized_blog_post_image_srcset(blog_post, image_slot, strict_proxy: strict_proxy),
           image_sizes: "(max-width: 699px) 100vw, 56vw",
           image_alt: blog_post.title,
           image_style: blog_post_cropped_image_style(blog_post, image_slot, frame_ratio: 16.0 / 9.0),
           image_loading: (image_priority ? "eager" : "lazy"),
           image_fetchpriority: ("high" if image_priority),
           image_decoding: "async",
           image_width: image_dimensions.fetch(:width),
           image_height: image_dimensions.fetch(:height),
           credit: nil,
           kicker_text: blog_post.promotion_banner_kicker_text_value,
           heading: blog_post.promotion_banner_title_value,
           subheading: (slider ? nil : blog_post.promotion_banner_text_value),
           cta_style: nil,
           cta_text: (slider ? "Zum Beitrag" : blog_post.promotion_banner_cta_text_value) %>
