<% share_headline = local_assigns[:share_headline].presence || presenter.display_headline %>
<% share_title = local_assigns[:share_title].presence || "#{share_headline} | Stuttgart Live" %>
<% share_text = local_assigns.key?(:share_text) ? local_assigns[:share_text].to_s.strip.presence : presenter.hero_meta_line.to_s.strip.presence %>
<% share_url = local_assigns[:share_url].presence || presenter.canonical_url %>
<% share_label = local_assigns[:share_label].presence || "#{share_headline} teilen" %>
<% share_classes = [ "event-share", local_assigns[:class] ].compact.join(" ") %>
<% share_button_classes = [ "event-share-button", local_assigns[:button_class] ].compact.join(" ") %>

<div class="<%= share_classes %>"
     data-controller="share-event"
     data-share-event-title-value="<%= share_title %>"
     data-share-event-text-value="<%= share_text %>"
     data-share-event-url-value="<%= share_url %>"
     data-share-event-copied-label-value="Link kopiert"
     data-share-event-error-label-value="Link konnte nicht kopiert werden">
  <%= button_tag type: "button",
                 class: share_button_classes,
                 title: share_label,
                 aria: { label: share_label },
                 data: {
                   action: "click->share-event#share",
                   share_event_target: "button"
                 } do %>
    <svg class="event-share-button-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16 5.5 12 1.75 8 5.5"></path>
      <path d="M12 2v13"></path>
      <path d="M5.25 10.5v8.25h13.5V10.5"></path>
    </svg>
    <% if local_assigns[:show_text] %>
      <span aria-hidden="true">Teilen</span>
    <% else %>
      <span class="sr-only">Teilen</span>
    <% end %>
  <% end %>
  <span class="event-share-status"
        role="status"
        aria-live="polite"
        data-share-event-target="status"></span>
</div>
