<% featured = local_assigns.fetch(:featured, false) %>
<% track_class = featured ? "home-featured-track" : "home-slider-track" %>
<% effective_series_ids = local_assigns[:effective_series_ids] || effective_public_event_series_ids(events) %>
<% strict_proxy = local_assigns.fetch(:strict_proxy, false) %>
<% lazy_lane_id = local_assigns[:lazy_lane_id] %>
<% lazy_next_cursor = local_assigns[:lazy_next_cursor] %>
<% lazy_list_next_cursor = local_assigns.fetch(:lazy_list_next_cursor, lazy_next_cursor) %>
<% lazy_url = local_assigns[:lazy_url] %>
<% open_grid = local_assigns.fetch(:open_grid, false) %>
<% list_events = lazy_lane_id.present? ? events.first(Public::EventsController::HOME_LANE_LIST_LIMIT) : events %>
<% section_cache_key = public_events_section_cache_key(
  section: "highlight",
  browse_state: browse_state,
  events: events,
  context: [ title, local_assigns[:title_url], featured, open_grid, list_aria_label, lazy_lane_id, lazy_next_cursor, lazy_url ],
  strict_proxy: strict_proxy
) %>

<% section_classes = [featured ? "home-featured-section" : "home-slider-section"] %>
<% section_classes << "home-slider-section--turquoise-title" if title.to_s.casecmp("Alle Veranstaltungen").zero? %>
<% nav_content = capture do %>
  <button type="button"
          class="slider-view-toggle"
          data-section-view-target="button"
          data-action="click->section-view#toggle"
          title="Listenansicht"
          aria-label="<%= list_aria_label %>"
          aria-pressed="false">
    <span class="slider-view-toggle-label" data-section-view-target="label">Listenansicht</span>
    <span class="slider-view-icon slider-view-icon-list public-view-icon public-view-icon-list" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="slider-view-icon slider-view-icon-grid public-view-icon public-view-icon-grid" aria-hidden="true">
      <span></span><span></span><span></span><span></span>
    </span>
  </button>
<% end %>

<% cache section_cache_key do %>
  <section class="<%= section_classes.join(" ") %> <%= "home-featured-section--open-grid" if open_grid %>"
           data-controller="<%= [("highlights-slider" unless open_grid), "section-view", ("homepage-lane" if lazy_lane_id.present? && !open_grid)].compact.join(" ") %>"
           <% if lazy_lane_id.present? && !open_grid %>
           data-homepage-lane-url-value="<%= lazy_url %>"
           data-homepage-lane-lane-value="<%= lazy_lane_id %>"
           data-homepage-lane-cursor-value="<%= lazy_next_cursor %>"
           data-homepage-lane-list-cursor-value="<%= lazy_list_next_cursor %>"
           data-homepage-lane-per-page-value="<%= Public::EventsController::HOME_LANE_LIMIT %>"
           data-homepage-lane-list-limit-value="<%= Public::EventsController::HOME_LANE_LIST_LIMIT %>"
           <% end %>
           <% if featured && !open_grid %>data-highlights-slider-autoplay-value="true" data-highlights-slider-interval-value="5000"<% end %>>
    <%= render "home_slider_header",
               title: title,
               title_url: local_assigns[:title_url],
               variant: :highlights,
               nav_content: nav_content,
               header_class: ("lane-header--turquoise-title" if title.to_s.casecmp("Alle Veranstaltungen").zero?) %>
    <div data-section-view-target="slider">
      <div class="<%= open_grid ? "featured-event-grid-viewport" : "highlights-slider-viewport" %>">
        <% unless open_grid %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-prev"
                data-highlights-slider-target="previousButton"
                data-action="click->highlights-slider#previous"
                aria-label="Zurück">
          ‹
        </button>
        <% end %>
        <div class="<%= [track_class, ("featured-event-grid" if open_grid)].compact.join(" ") %>"
             data-highlights-slider-target="track"
             <% if lazy_lane_id.present? && !open_grid %>data-homepage-lane-target="track"<% end %>>
          <% events.each_with_index do |event, index| %>
            <% if featured %>
              <% tile_variant = effective_public_grid_variant_for(event, index) %>
              <% card_slot = card_slot_for_grid_variant(tile_variant) %>
              <%= render "home_feature_card",
                         event: event,
                         browse_state: browse_state,
                         effective_series_ids: effective_series_ids,
                         strict_proxy: strict_proxy,
                         tile_variant: tile_variant,
                         card_slot: card_slot %>
            <% else %>
              <%= render "home_slider_card",
                         event: event,
                         browse_state: browse_state,
                         effective_series_ids: effective_series_ids,
                         strict_proxy: strict_proxy %>
            <% end %>
          <% end %>
        </div>
        <% unless open_grid %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-next"
                data-highlights-slider-target="nextButton"
                data-action="click->highlights-slider#next"
                aria-label="Weiter">
          ›
        </button>
        <% end %>
      </div>
    </div>
    <div class="section-slider-list-viewport"
         data-section-view-target="list"
         hidden>
      <% if lazy_lane_id.present? %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-prev section-slider-list-arrow"
                data-action="click->homepage-lane#previousList"
                aria-label="Zurück">
          ‹
        </button>
      <% end %>
      <div class="section-slider-list"
           <% if lazy_lane_id.present? %>data-homepage-lane-target="list"<% end %>>
        <%= render "event_rows",
                   events: list_events,
                   browse_state: browse_state,
                   effective_series_ids: effective_series_ids,
                   strict_proxy: strict_proxy %>
      </div>
      <% if lazy_lane_id.present? %>
        <button type="button"
                class="highlights-slider-arrow highlights-slider-arrow-overlay highlights-slider-arrow-next section-slider-list-arrow"
                data-action="click->homepage-lane#nextList"
                aria-label="Weiter">
          ›
        </button>
      <% end %>
    </div>
  </section>
<% end %>
