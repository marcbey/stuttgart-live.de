<button type="button"
        class="saved-events-clear-button"
        data-controller="saved-events-clear"
        data-saved-events-clear-page-url-value="<%= saved_events_path %>"
        data-action="saved-events-clear#clear"
        hidden>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5"></path>
  </svg>
  <% if local_assigns[:compact_label] %>
    <span class="saved-events-action-label-long"><%= local_assigns.fetch(:label, "Merkliste leeren") %></span>
    <span class="saved-events-action-label-short"><%= compact_label %></span>
  <% else %>
    <span><%= local_assigns.fetch(:label, "Merkliste leeren") %></span>
  <% end %>
</button>
