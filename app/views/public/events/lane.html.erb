<% lane_display_title = @lane_title.presence || @lane.title %>
<%= render_public_seo title: "Stuttgart Live - #{lane_display_title}",
                      description: public_lane_seo_description(@lane),
                      canonical_url: public_lane_canonical_url(@lane),
                      json_ld: public_event_item_list_json_ld(
                        @lane_events,
                        name: lane_display_title,
                        canonical_url: public_lane_canonical_url(@lane)
                      ) %>
<% content_for :page_newsletter do %><% end %>
<% content_for :page_partner_strip do %><% end %>
<% strict_proxy = homepage_media_strict_proxy? %>
<% genre_lanes = public_design_navigation_lanes(Array(@design_chrome_genre_lanes).first(5), highlight_events: @home_featured_events) %>
<% design_chrome_saved_events = (Array(@design_chrome_saved_events) + Array(@lane_events)).compact.uniq(&:id) %>

<div class="design-preview design-preview-list-shell"
     data-controller="design-preview-menu design-preview-filterbar">
  <%= render "design_preview_header",
             browse_state: @browse_state,
             genre_lanes: genre_lanes,
             search_overlay: @design_preview_search_overlay,
             menu_groups: public_design_menu_groups,
             saved_events: design_chrome_saved_events,
             strict_proxy: strict_proxy %>

  <main class="design-preview-list-page">
    <%= link_to public_events_index_path(@browse_state),
                class: "design-detail-preview-back",
                aria: { label: "Zurück" },
                data: { controller: "history-back-link", action: "click->history-back-link#navigate" } do %>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H6"></path>
        <path d="m11 6-6 6 6 6"></path>
      </svg>
      Zurück
    <% end %>

    <% if @lane.key == "all_stuttgart" %>
      <%= render "design_preview_tagestipp_lane",
                 events: @home_tagestipp_events,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 effective_series_ids: @home_tagestipp_effective_series_ids,
                 title_id: "all-stuttgart-tagestipp-title" %>

      <%= render "all_stuttgart_filterbar",
                 genre_lanes: genre_lanes,
                 months: @lane_months,
                 selected_month: @lane_selected_month,
                 month_labels_by_value: @lane_month_labels_by_value,
                 selected_genre: @all_stuttgart_selected_genre %>

      <%= render "all_stuttgart_event_list",
                 title: lane_display_title,
                 events: @lane_events,
                 browse_state: @browse_state,
                 genres: @all_stuttgart_genres,
                 selected_genre: @all_stuttgart_selected_genre,
                 selected_month: @lane_selected_month %>
    <% else %>
      <%= render "lane_page_section",
                 lane: @lane,
                 title: lane_display_title,
                 events: @lane_events,
                 effective_series_ids: @lane_effective_series_ids,
                 series_counts_by_id: @lane_series_counts_by_id,
                 browse_state: @browse_state,
                 strict_proxy: strict_proxy,
                 lazy_lane_id: @lane_lazy_id,
                 lazy_url: @lane_lazy_url,
                 lazy_next_cursor: @lane_next_cursor,
                 lazy_list_next_cursor: @lane_list_next_cursor,
                 lazy_per_page: Public::EventsController::LANE_PAGE_LIMIT %>
    <% end %>
  </main>

  <%= render "design_preview_footer", menu_groups: public_design_menu_groups %>
</div>
