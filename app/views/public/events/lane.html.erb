<% content_for :title, "Stuttgart Live - #{@lane.title}" %>
<% content_for :page_newsletter do %>
  <%= render "newsletter_signup", browse_state: @browse_state %>
<% end %>

<section class="public-shell">
  <div class="lane-page-topbar">
    <p class="event-detail-back">
      <%= link_to public_events_index_path(@browse_state),
                  aria: { label: "Zurück" },
                  data: { controller: "history-back-link", action: "click->history-back-link#navigate" } do %>
        <%= render "public/events/back_link_icon" %>
      <% end %>
    </p>
  </div>

  <%= render "lane_page_section",
             lane: @lane,
             events: @lane_events,
             effective_series_ids: @lane_effective_series_ids,
             series_counts_by_id: @lane_series_counts_by_id,
             browse_state: @browse_state,
             strict_proxy: homepage_media_strict_proxy? %>
</section>
