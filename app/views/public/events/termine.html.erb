<%= render_public_seo title: "Stuttgart Live - #{@event_series_lane.title}",
                      description: "#{@event_series_lane.title}: alle aktuellen Termine in Stuttgart und Region.",
                      canonical_url: termine_event_url(@event.slug),
                      json_ld: public_event_item_list_json_ld(
                        @event_series_lane.events,
                        name: @event_series_lane.title,
                        canonical_url: termine_event_url(@event.slug)
                      ) %>
<% content_for :page_newsletter do %>
  <%= render "newsletter_signup", browse_state: @browse_state %>
<% end %>

<section class="public-shell">
  <div class="lane-page-topbar">
    <p class="event-detail-back">
      <%= link_to public_event_detail_path(@event, @browse_state),
                  aria: { label: "Zurück" },
                  data: { controller: "history-back-link", action: "click->history-back-link#navigate" } do %>
        <%= render "public/events/back_link_icon" %>
      <% end %>
    </p>
  </div>

  <section class="home-slider-section lane-page-section search-results-section">
    <%= render "home_slider_header",
               title: @event_series_lane.title,
               kicker: "Event-Reihe",
               variant: :genre %>

    <div class="section-slider-list genre-lane-list event-series-terms-page-list">
      <%= render "event_rows",
                 events: @event_series_lane.events,
                 browse_state: @browse_state,
                 effective_series_ids: [@event_series_lane.series.id],
                 row_dom_id_prefix: :event_series_terms_row %>
    </div>
  </section>
</section>
