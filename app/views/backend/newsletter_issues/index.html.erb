<% content_for :title, "Newsletter" %>

<section class="backend-shell backend-inbox-shell">
  <header class="backend-topbar backend-topbar-sticky backend-inbox-topbar">
    <div class="backend-topbar-title">
      <h1>Newsletter</h1>
    </div>
  </header>

  <div class="backend-split backend-inbox-split">
    <aside class="backend-list-column newsletter-issues-list-column">
      <div class="backend-status-row newsletter-issues-list-header">
        <div class="newsletter-issues-create-actions" aria-label="Wochenmix-Variante erstellen">
          <%= button_to create_weekly_genre_mix_backend_newsletters_path,
                        method: :post,
                        params: { variant: "mixed" },
                        title: "Neuen Wochenmix-Testdraft mit 10 gemischten Events erstellen",
                        class: "button button-secondary button-compact newsletter-issues-create-button" do %>
            <span class="newsletter-issues-create-label">Wochenmix</span>
            <span class="newsletter-issues-create-meta">(10 Events im Mix)</span>
          <% end %>
          <%= button_to create_weekly_genre_mix_backend_newsletters_path,
                        method: :post,
                        params: { items_per_genre: 3 },
                        title: "Neuen Wochenmix-Testdraft mit 3 Events pro Genre erstellen",
                        class: "button button-secondary button-compact newsletter-issues-create-button" do %>
            <span class="newsletter-issues-create-label">Genre small</span>
            <span class="newsletter-issues-create-meta">(3 Events pro Genre)</span>
          <% end %>
          <%= button_to create_weekly_genre_mix_backend_newsletters_path,
                        method: :post,
                        params: { items_per_genre: 6 },
                        title: "Neuen Wochenmix-Testdraft mit 6 Events pro Genre erstellen",
                        class: "button button-secondary button-compact newsletter-issues-create-button" do %>
            <span class="newsletter-issues-create-label">Genre large</span>
            <span class="newsletter-issues-create-meta">(6 Events pro Genre)</span>
          <% end %>
        </div>
      </div>
      <div class="backend-list newsletter-issues-list">
        <% @issues.each do |issue| %>
          <div class="backend-list-row newsletter-issue-list-row <%= 'backend-list-row-active newsletter-issue-list-row-active' if @issue == issue %>">
            <%= link_to backend_newsletter_path(issue), class: "newsletter-issue-list-link" do %>
              <span class="newsletter-issue-list-main">
                <strong class="newsletter-issue-list-title"><%= issue.backend_list_title %></strong>
                <span class="newsletter-issue-list-meta">
                  Aktualisiert <%= l(issue.updated_at, format: "%d.%m.%y %H:%M") %>
                </span>
              </span>
            <% end %>
            <span class="newsletter-issue-list-controls">
              <span class="newsletter-issue-list-status <%= newsletter_issue_status_class(issue) %>">
                <%= newsletter_issue_status_label(issue) %>
              </span>
              <%= link_to "×",
                          backend_newsletter_path(issue),
                          data: { turbo_method: :delete, turbo_confirm: "Newsletter-Ausgabe wirklich dauerhaft löschen?" },
                          aria: { label: "#{issue.backend_list_title} löschen" },
                          title: "Newsletter-Ausgabe löschen",
                          class: "newsletter-issue-list-delete" %>
            </span>
          </div>
        <% end %>
      </div>
    </aside>

    <section class="backend-editor-column backend-inbox-editor-column">
      <% if @issue.persisted? %>
        <%= render "detail", issue: @issue, available_events: @available_events, available_blog_posts: @available_blog_posts %>
      <% else %>
        <div class="empty-state">Noch keine Newsletter-Ausgabe ausgewählt.</div>
      <% end %>
    </section>
  </div>
</section>
