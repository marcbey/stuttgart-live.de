<%= turbo_frame_tag "redirect_editor" do %>
  <%= hidden_field_tag :redirect_id, rule.id, form: "redirect_filters" if rule&.persisted? %>
  <% if rule.present? %>
    <%= render "form", rule: rule, list_context: list_context, page_number: page_number %>
  <% else %>
    <div class="empty-state">Keine Weiterleitungen zur aktuellen Filterung.</div>
  <% end %>
<% end %>
