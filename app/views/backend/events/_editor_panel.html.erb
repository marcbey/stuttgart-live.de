<% next_event_enabled = local_assigns.fetch(:next_event_enabled, true) %>
<% filter_status = local_assigns[:filter_status] %>
<% editor_status = filter_status.presence || event.status %>
<% active_editor_tab = local_assigns[:active_editor_tab].presence || "event" %>
<% lazy_inactive_tabs = local_assigns.fetch(:lazy_inactive_tabs, false) %>
<% all_presenters = local_assigns[:all_presenters] || [] %>
<% llm_enrichment = event.llm_enrichment %>
<% form_errors = event_editor_errors(event) %>
<% event_tab_active = active_editor_tab == "event" %>
<% event_image_tab_active = active_editor_tab == "event_image" %>
<% slider_images_tab_active = active_editor_tab == "slider_images" %>
<% presenters_tab_active = active_editor_tab == "presenters" %>
<% llm_tab_active = active_editor_tab == "llm_enrichment" %>
<% social_tab_active = active_editor_tab == "social" %>
<% settings_tab_active = active_editor_tab == "settings" %>
<% llm_tab_available = event.persisted? %>
<% social_tab_available = event.persisted? %>
<% editor_form_id = dom_id(event, :editor_form) %>
<% editor_tab_url_attribute = lambda do |tab_key, active|
     if lazy_inactive_tabs && !active
       url = backend_event_path(event, status: filter_status.presence, editor_tab: (tab_key == "event" ? nil : tab_key))
       %(data-event-editor-tabs-url-param="#{ERB::Util.html_escape(url)}").html_safe
     end
   end %>

<div class="editor-panel backend-panel"
     id="event_editor_panel">
  <template class="editor-actions-template">
    <%= render "backend/events/editor_actions", event: event, next_event_enabled: next_event_enabled, filter_status: filter_status %>
  </template>

  <header class="editor-header">
    <div>
      <p class="eyebrow">Event #<%= event.id %></p>
      <h2><%= event.artist_name.presence || "Unbenannt" %></h2>
      <p><%= event.title %></p>
    </div>
    <div class="editor-header-badges">
      <% if backend_event_series_effective?(event) %>
        <span class="status-badge status-badge-series">Event-Reihe</span>
      <% end %>
      <span class="<%= event_display_status_badge_class(event) %>"><%= event_display_status_label(event) %></span>
      <% if event.primary_source.present? %>
        <span class="status-badge status-badge-default"><%= event.primary_source %></span>
      <% end %>
    </div>
  </header>

  <% if form_errors.any? %>
    <div class="flash flash-alert">
      <strong>Bitte Eingaben prüfen.</strong>
      <ul>
        <% form_errors.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="event-editor-tabs"
           data-controller="event-editor-tabs"
           data-event-editor-tabs-initial-tab-value="<%= active_editor_tab %>">
    <div class="settings-tabs-nav event-editor-tabs-nav" role="tablist" aria-label="Event-Editor Ansichten">
      <button type="button"
              id="event-editor-tab-event"
              class="settings-tabs-link<%= " is-active" if event_tab_active %>"
              role="tab"
              aria-controls="event-editor-panel-event"
              aria-selected="<%= event_tab_active %>"
              tabindex="<%= event_tab_active ? 0 : -1 %>"
              data-event-editor-tabs-target="tab"
              data-event-editor-tabs-tab-key-param="event"
              <%= editor_tab_url_attribute.call("event", event_tab_active) %>
              data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
        Event
      </button>
      <button type="button"
              id="event-editor-tab-event-image"
              class="settings-tabs-link<%= " is-active" if event_image_tab_active %>"
              role="tab"
              aria-controls="event-editor-panel-event-image"
              aria-selected="<%= event_image_tab_active %>"
              tabindex="<%= event_image_tab_active ? 0 : -1 %>"
              data-event-editor-tabs-target="tab"
              data-event-editor-tabs-tab-key-param="event_image"
              <%= editor_tab_url_attribute.call("event_image", event_image_tab_active) %>
              data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
        Eventbild
      </button>
      <button type="button"
              id="event-editor-tab-slider-images"
              class="settings-tabs-link<%= " is-active" if slider_images_tab_active %>"
              role="tab"
              aria-controls="event-editor-panel-slider-images"
              aria-selected="<%= slider_images_tab_active %>"
              tabindex="<%= slider_images_tab_active ? 0 : -1 %>"
              data-event-editor-tabs-target="tab"
              data-event-editor-tabs-tab-key-param="slider_images"
              <%= editor_tab_url_attribute.call("slider_images", slider_images_tab_active) %>
              data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
        Presse
      </button>
      <button type="button"
              id="event-editor-tab-presenters"
              class="settings-tabs-link<%= " is-active" if presenters_tab_active %>"
              role="tab"
              aria-controls="event-editor-panel-presenters"
              aria-selected="<%= presenters_tab_active %>"
              tabindex="<%= presenters_tab_active ? 0 : -1 %>"
              data-event-editor-tabs-target="tab"
              data-event-editor-tabs-tab-key-param="presenters"
              <%= editor_tab_url_attribute.call("presenters", presenters_tab_active) %>
              data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
        Präsentatoren
      </button>
      <% if llm_tab_available %>
        <button type="button"
                id="event-editor-tab-llm-enrichment"
                class="settings-tabs-link<%= " is-active" if llm_tab_active %>"
                role="tab"
                aria-controls="event-editor-panel-llm-enrichment"
                aria-selected="<%= llm_tab_active %>"
                tabindex="<%= llm_tab_active ? 0 : -1 %>"
                data-event-editor-tabs-target="tab"
                data-event-editor-tabs-tab-key-param="llm_enrichment"
                <%= editor_tab_url_attribute.call("llm_enrichment", llm_tab_active) %>
                data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
          LLM-Enrichment
        </button>
      <% end %>
      <% if social_tab_available %>
        <button type="button"
                id="event-editor-tab-social"
                class="settings-tabs-link<%= " is-active" if social_tab_active %>"
                role="tab"
                aria-controls="event-editor-panel-social"
                aria-selected="<%= social_tab_active %>"
                tabindex="<%= social_tab_active ? 0 : -1 %>"
                data-event-editor-tabs-target="tab"
                data-event-editor-tabs-tab-key-param="social"
                <%= editor_tab_url_attribute.call("social", social_tab_active) %>
                data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
          Social
        </button>
      <% end %>
      <button type="button"
              id="event-editor-tab-settings"
              class="settings-tabs-link<%= " is-active" if settings_tab_active %>"
              role="tab"
              aria-controls="event-editor-panel-settings"
              aria-selected="<%= settings_tab_active %>"
              tabindex="<%= settings_tab_active ? 0 : -1 %>"
              data-event-editor-tabs-target="tab"
              data-event-editor-tabs-tab-key-param="settings"
              <%= editor_tab_url_attribute.call("settings", settings_tab_active) %>
              data-action="click->event-editor-tabs#activate keydown->event-editor-tabs#keydown">
        Einstellungen
      </button>
    </div>

    <div class="settings-tabs-panels backend-tabs-panels">
      <section id="event-editor-panel-event"
               class="settings-tab-panel backend-tab-panel<%= " is-active" if event_tab_active %>"
               role="tabpanel"
               aria-labelledby="event-editor-tab-event"
               tabindex="0"
               <%= "hidden" unless event_tab_active %>
               data-event-editor-tabs-target="panel"
               data-event-editor-tabs-panel-key="event">
        <%= render "backend/events/editor_event_view",
                   event: event,
                   all_genres: all_genres,
                   all_sub_genres: all_sub_genres,
                   next_event_enabled: next_event_enabled,
                   filter_status: filter_status,
                   active_editor_tab: active_editor_tab,
                   manual_ticket_url: local_assigns[:manual_ticket_url],
                   manual_ticket_sold_out: local_assigns[:manual_ticket_sold_out] %>
      </section>

      <section id="event-editor-panel-event-image"
               class="settings-tab-panel backend-tab-panel<%= " is-active" if event_image_tab_active %>"
               role="tabpanel"
               aria-labelledby="event-editor-tab-event-image"
               tabindex="0"
               <%= "hidden" unless event_image_tab_active %>
               data-event-editor-tabs-target="panel"
               data-event-editor-tabs-panel-key="event_image">
        <% if event_image_tab_active || !lazy_inactive_tabs %>
          <%= render "backend/events/event_image_section",
                     event: event,
                     editor_status: editor_status,
                     editor_form_id: editor_form_id %>
        <% end %>
      </section>

      <section id="event-editor-panel-slider-images"
               class="settings-tab-panel backend-tab-panel<%= " is-active" if slider_images_tab_active %>"
               role="tabpanel"
               aria-labelledby="event-editor-tab-slider-images"
               tabindex="0"
               <%= "hidden" unless slider_images_tab_active %>
               data-event-editor-tabs-target="panel"
               data-event-editor-tabs-panel-key="slider_images">
        <% if slider_images_tab_active || !lazy_inactive_tabs %>
          <%= render "backend/events/slider_images_section",
                     event: event,
                     editor_status: editor_status,
                     editor_form_id: editor_form_id %>
        <% end %>
      </section>

      <section id="event-editor-panel-presenters"
               class="settings-tab-panel backend-tab-panel<%= " is-active" if presenters_tab_active %>"
               role="tabpanel"
               aria-labelledby="event-editor-tab-presenters"
               tabindex="0"
               <%= "hidden" unless presenters_tab_active %>
               data-event-editor-tabs-target="panel"
               data-event-editor-tabs-panel-key="presenters">
        <% if presenters_tab_active || !lazy_inactive_tabs %>
          <%= render "backend/events/presenters_section",
                     event: event,
                     all_presenters: all_presenters,
                     editor_form_id: editor_form_id %>
        <% end %>
      </section>

      <% if llm_tab_available %>
        <section id="event-editor-panel-llm-enrichment"
                 class="settings-tab-panel backend-tab-panel<%= " is-active" if llm_tab_active %>"
                 role="tabpanel"
                 aria-labelledby="event-editor-tab-llm-enrichment"
                 tabindex="0"
                 <%= "hidden" unless llm_tab_active %>
                 data-event-editor-tabs-target="panel"
                 data-event-editor-tabs-panel-key="llm_enrichment">
          <% if llm_tab_active || !lazy_inactive_tabs %>
            <%= render "backend/events/llm_enrichment_fields",
                       event: event,
                       llm_enrichment: llm_enrichment,
                       all_genres: all_genres,
                       editor_form_id: editor_form_id,
                       filter_status: filter_status %>
          <% end %>
        </section>
      <% end %>

      <% if social_tab_available %>
        <section id="event-editor-panel-social"
                 class="settings-tab-panel backend-tab-panel<%= " is-active" if social_tab_active %>"
                 role="tabpanel"
                 aria-labelledby="event-editor-tab-social"
                 tabindex="0"
                 <%= "hidden" unless social_tab_active %>
                 data-event-editor-tabs-target="panel"
                 data-event-editor-tabs-panel-key="social">
          <% if social_tab_active || !lazy_inactive_tabs %>
            <%= render "backend/events/social_posts_section",
                       event: event,
                       filter_status: filter_status %>
          <% end %>
        </section>
      <% end %>

      <section id="event-editor-panel-settings"
               class="settings-tab-panel backend-tab-panel<%= " is-active" if settings_tab_active %>"
               role="tabpanel"
               aria-labelledby="event-editor-tab-settings"
               tabindex="0"
               <%= "hidden" unless settings_tab_active %>
               data-event-editor-tabs-target="panel"
               data-event-editor-tabs-panel-key="settings">
        <% if settings_tab_active || !lazy_inactive_tabs %>
          <%= render "backend/events/settings_fields",
                     event: event,
                     all_genres: all_genres,
                     all_sub_genres: all_sub_genres,
                     editor_form_id: editor_form_id %>
        <% end %>
      </section>
    </div>
  </section>
</div>
