<% editor_form_id = local_assigns.fetch(:editor_form_id, dom_id(event, :editor_form)) %>

<div class="backend-section-stack">
  <section class="backend-section backend-section-compact editor-subsection">
    <div class="backend-section-header">
      <h3>Highlights-Teaser</h3>
    </div>
    <div class="backend-section-body">
      <label class="form-checkbox">
        <%= hidden_field_tag "event[highlighted]", "0", form: editor_form_id, id: nil %>
        <%= check_box_tag "event[highlighted]", "1", event.highlighted?, form: editor_form_id %>
        <span>Im Highlights-Teaser anzeigen</span>
      </label>
      <p class="form-hint">Zeigt das Event auf der Startseite unter „Highlights“ an, auch ohne SKS Promoter-ID.</p>
    </div>
  </section>

  <section class="backend-section backend-section-compact editor-subsection">
    <div class="backend-section-header">
      <h3>Promotion Banner</h3>
    </div>
    <div class="backend-section-body">
      <label class="form-checkbox form-checkbox-after-textarea">
        <%= hidden_field_tag "event[promotion_banner]", "0", form: editor_form_id, id: nil %>
        <%= check_box_tag "event[promotion_banner]",
                          "1",
                          event.promotion_banner?,
                          form: editor_form_id %>
        <span>Als Promotion Banner markieren</span>
      </label>
      <p class="form-hint">Mehrere Events und News können gleichzeitig als Promotion Banner aktiv sein. Ohne Lane-Position erscheint der Banner nur im Slider oben. Mit Lane-Position erscheint er zusätzlich an der definierten Stelle auf der Startseite. Auf der Startseite wird der Banner nur angezeigt, wenn auch ein Eventbild vorhanden ist.</p>

      <div class="editor-grid promotion-banner-settings-grid">
        <div>
          <%= label_tag "event_promotion_banner_lane_position", "Lane-Position", class: "form-label" %>
          <%= number_field_tag "event[promotion_banner_lane_position]",
                               event.promotion_banner_lane_position,
                               id: "event_promotion_banner_lane_position",
                               class: "form-input",
                               min: 1,
                               step: 1,
                               form: editor_form_id %>
          <p class="form-hint">Leer bedeutet nur Slider. 1 unter Heute in Stuttgart, 2 unter News, 3 unter Stuttgart im Mix, 4 unter Unter 30€ - Kleine Preise, große Abende.</p>
        </div>

        <div>
          <%= label_tag "event_promotion_banner_kicker_text", "Kicker", class: "form-label" %>
          <%= text_field_tag "event[promotion_banner_kicker_text]",
                             event.promotion_banner_kicker_text_value,
                             id: "event_promotion_banner_kicker_text",
                             class: "form-input",
                             maxlength: 80,
                             form: editor_form_id %>
        </div>

        <div>
          <%= label_tag "event_promotion_banner_title", "Titel", class: "form-label" %>
          <%= text_field_tag "event[promotion_banner_title]",
                             event.promotion_banner_title_value,
                             id: "event_promotion_banner_title",
                             class: "form-input",
                             maxlength: 120,
                             form: editor_form_id %>
        </div>

        <div>
          <%= label_tag "event_promotion_banner_text", "Text", class: "form-label" %>
          <%= text_field_tag "event[promotion_banner_text]",
                             event.promotion_banner_text_value,
                             id: "event_promotion_banner_text",
                             class: "form-input",
                             maxlength: 320,
                             form: editor_form_id %>
        </div>

        <div>
          <%= label_tag "event_promotion_banner_cta_text", "Button", class: "form-label" %>
          <%= text_field_tag "event[promotion_banner_cta_text]",
                             event.promotion_banner_cta_text_value,
                             id: "event_promotion_banner_cta_text",
                             class: "form-input",
                             maxlength: 80,
                             form: editor_form_id %>
        </div>

        <div data-controller="promotion-banner-color"
             data-promotion-banner-color-default-color-value="<%= event.promotion_banner_background_color_value %>">
          <%= label_tag "event_promotion_banner_background_color", "Hintergrundfarbe", class: "form-label" %>
          <div class="promotion-banner-color-inputs">
            <%= text_field_tag "event[promotion_banner_background_color]",
                               event.promotion_banner_background_color,
                               id: "event_promotion_banner_background_color",
                               class: "form-input",
                               inputmode: "text",
                               maxlength: 7,
                               placeholder: Event::DEFAULT_PROMOTION_BANNER_BACKGROUND_COLOR,
                               form: editor_form_id,
                               data: {
                                 action: "input->promotion-banner-color#syncFromHex blur->promotion-banner-color#normalizeHex",
                                 promotion_banner_color_target: "hex"
                               } %>
            <%= color_field_tag "event_promotion_banner_background_color_picker",
                                event.promotion_banner_background_color_value,
                                id: "event_promotion_banner_background_color_picker",
                                class: "promotion-banner-color-picker",
                                form: editor_form_id,
                                data: {
                                  action: "input->promotion-banner-color#syncFromPicker change->promotion-banner-color#syncFromPicker",
                                  promotion_banner_color_target: "picker"
                                } %>
            <button type="button"
                    class="promotion-banner-color-eyedropper"
                    hidden
                    title="Farbe aus dem Browserfenster aufnehmen"
                    aria-label="Farbe aus dem Browserfenster aufnehmen"
                    data-action="click->promotion-banner-color#pickFromScreen"
                    data-promotion-banner-color-target="eyedropper">
              Pipette
            </button>
          </div>
          <p class="form-hint">Optional. Leer nutzt <%= Event::DEFAULT_PROMOTION_BANNER_BACKGROUND_COLOR %>.</p>
        </div>
      </div>

      <p class="form-hint">Leer gelassene Texte fallen automatisch auf die Standardwerte zurück.</p>

      <%= fields_for :event, event do |form| %>
        <%= render "backend/shared/promotion_banner_image_editor",
                   form: form,
                   form_id: editor_form_id,
                   title: "Promotion-Banner Hochformat",
                   description: "Wird im Highlight-Slider der Startseite verwendet. Wenn kein Bild gepflegt ist, wird das Eventbild genutzt.",
                   section_classes: "promotion-banner-image-section",
                   image_blob: event.promotion_banner_image_blob_for_editor,
                   signed_input_name: "event_promotion_banner_image[promotion_banner_image_signed_id]",
                   signed_input_value: event.pending_promotion_banner_image_blob&.signed_id,
                   remove_input_name: "event_promotion_banner_image[remove_promotion_banner_image]",
                   remove_value: (event.remove_promotion_banner_image? ? "1" : "0"),
                   upload_input_id: "#{editor_form_id}_promotion_banner_image_upload",
                   copyright_attribute: :promotion_banner_image_copyright,
                   copyright_value: event.promotion_banner_image_copyright,
                   focus_x_attribute: :promotion_banner_image_focus_x,
                   focus_y_attribute: :promotion_banner_image_focus_y,
                   zoom_attribute: :promotion_banner_image_zoom,
                   focus_x_value: event.promotion_banner_image_focus_x_value,
                   focus_y_value: event.promotion_banner_image_focus_y_value,
                   zoom_value: event.promotion_banner_image_zoom_value,
                   image_alt: "#{event.artist_name} Promotion Banner",
                   preview_variant: "promotion-banner" %>

        <%= render "backend/shared/promotion_banner_image_editor",
                   form: form,
                   form_id: editor_form_id,
                   title: "Promotion-Banner Querformat",
                   description: "Optionales Querformat für die breiten Promotionbanner im Content. Wenn nichts gepflegt ist, wird das Eventbild genutzt.",
                   section_classes: "promotion-banner-image-section",
                   image_blob: event.promotion_banner_landscape_image_blob_for_editor,
                   signed_input_name: "event_promotion_banner_landscape_image[promotion_banner_landscape_image_signed_id]",
                   signed_input_value: event.pending_promotion_banner_landscape_image_blob&.signed_id,
                   remove_input_name: "event_promotion_banner_landscape_image[remove_promotion_banner_landscape_image]",
                   remove_value: (event.remove_promotion_banner_landscape_image? ? "1" : "0"),
                   upload_input_id: "#{editor_form_id}_promotion_banner_landscape_image_upload",
                   copyright_attribute: :promotion_banner_landscape_image_copyright,
                   copyright_value: event.promotion_banner_landscape_image_copyright,
                   focus_x_attribute: :promotion_banner_landscape_image_focus_x,
                   focus_y_attribute: :promotion_banner_landscape_image_focus_y,
                   zoom_attribute: :promotion_banner_landscape_image_zoom,
                   focus_x_value: event.promotion_banner_landscape_image_focus_x_value,
                   focus_y_value: event.promotion_banner_landscape_image_focus_y_value,
                   zoom_value: event.promotion_banner_landscape_image_zoom_value,
                   image_alt: "#{event.artist_name} Promotion Banner Querformat",
                   preview_variant: "2x1" %>
      <% end %>

      <section class="settings-highlight-video-upload">
        <div>
          <h3>Highlight-Video hochkant</h3>
          <p class="form-hint">Optionales Hochformatvideo für die rechte Highlight-Fläche auf der Startseite. Wenn kein Event-Video gepflegt ist, greift das globale Fallback-Video aus den Einstellungen.</p>
        </div>

        <label class="check-inline">
          <%= hidden_field_tag "event[highlight_video_overlay_enabled]", "0", form: editor_form_id, id: nil %>
          <%= check_box_tag "event[highlight_video_overlay_enabled]",
                            "1",
                            event.highlight_video_overlay_enabled?,
                            form: editor_form_id,
                            id: "#{editor_form_id}_highlight_video_overlay_enabled" %>
          <span>Texteinblendung über Video anzeigen</span>
        </label>

        <div data-controller="homepage-highlight-video-upload"
             data-homepage-highlight-video-upload-direct-upload-url-value="<%= rails_direct_uploads_url %>"
             data-homepage-highlight-video-upload-media-type-value="video">
          <div class="settings-highlight-video-preview settings-highlight-video-preview--portrait">
            <% if event.highlight_video_file_blob_for_editor.present? %>
              <%= video_tag url_for(event.highlight_video_file_blob_for_editor),
                            controls: true,
                            muted: true,
                            playsinline: true,
                            preload: "metadata",
                            class: "settings-highlight-video-preview-media",
                            data: { homepage_highlight_video_upload_target: "preview" } %>
            <% else %>
              <video class="settings-highlight-video-preview-media is-hidden"
                     controls
                     muted
                     playsinline
                     data-homepage-highlight-video-upload-target="preview"></video>
            <% end %>
          </div>

          <% event_highlight_video_input_id = "#{editor_form_id}_highlight_video_file" %>
          <div class="settings-highlight-video-actions">
            <%= hidden_field_tag "event_highlight_video[highlight_video_signed_id]",
                                 event.pending_highlight_video_blob&.signed_id.to_s,
                                 form: editor_form_id,
                                 data: { homepage_highlight_video_upload_target: "signedInput" } %>
            <%= hidden_field_tag "event_highlight_video[remove_highlight_video]",
                                 (event.remove_highlight_video? ? "1" : "0"),
                                 form: editor_form_id,
                                 data: { homepage_highlight_video_upload_target: "removeInput" } %>
            <%= file_field_tag "event_highlight_video_file",
                               id: event_highlight_video_input_id,
                               accept: "video/mp4,video/quicktime,video/webm",
                               class: "settings-highlight-video-file-input",
                               data: {
                                 homepage_highlight_video_upload_target: "input",
                                 action: "change->homepage-highlight-video-upload#select"
                               } %>
            <label class="button button-secondary button-compact settings-highlight-video-file-button"
                   for="<%= event_highlight_video_input_id %>">
              Datei auswählen
            </label>
            <span class="settings-highlight-video-file-name"
                  data-homepage-highlight-video-upload-target="fileName">
              <%= event.highlight_video_file_blob_for_editor.present? ? "Video vorhanden" : "Keine Datei ausgewählt" %>
            </span>
            <button type="button"
                    class="button button-ghost button-compact"
                    data-homepage-highlight-video-upload-target="removeButton"
                    data-action="homepage-highlight-video-upload#remove">
              Entfernen
            </button>
          </div>
          <p class="form-hint" data-homepage-highlight-video-upload-target="status"></p>
        </div>
      </section>

      <section class="settings-highlight-video-upload">
        <div>
          <h3>Highlight-Video quer</h3>
          <p class="form-hint">Optionales Querformatvideo für die Video-Kachel in „Stuttgart im Mix“ und später „Alles aus Stuttgart“. Wenn hier nichts gepflegt ist, bleibt das aktuelle Fallback-Video aktiv.</p>
        </div>

        <div data-controller="homepage-highlight-video-upload"
             data-homepage-highlight-video-upload-direct-upload-url-value="<%= rails_direct_uploads_url %>"
             data-homepage-highlight-video-upload-media-type-value="video">
          <div class="settings-highlight-video-preview settings-highlight-video-preview--landscape">
            <% if event.highlight_landscape_video_file_blob_for_editor.present? %>
              <%= video_tag url_for(event.highlight_landscape_video_file_blob_for_editor),
                            controls: true,
                            muted: true,
                            playsinline: true,
                            preload: "metadata",
                            class: "settings-highlight-video-preview-media",
                            data: { homepage_highlight_video_upload_target: "preview" } %>
            <% else %>
              <video class="settings-highlight-video-preview-media is-hidden"
                     controls
                     muted
                     playsinline
                     data-homepage-highlight-video-upload-target="preview"></video>
            <% end %>
          </div>

          <% event_highlight_landscape_video_input_id = "#{editor_form_id}_highlight_landscape_video_file" %>
          <div class="settings-highlight-video-actions">
            <%= hidden_field_tag "event_highlight_landscape_video[highlight_landscape_video_signed_id]",
                                 event.pending_highlight_landscape_video_blob&.signed_id.to_s,
                                 form: editor_form_id,
                                 data: { homepage_highlight_video_upload_target: "signedInput" } %>
            <%= hidden_field_tag "event_highlight_landscape_video[remove_highlight_landscape_video]",
                                 (event.remove_highlight_landscape_video? ? "1" : "0"),
                                 form: editor_form_id,
                                 data: { homepage_highlight_video_upload_target: "removeInput" } %>
            <%= file_field_tag "event_highlight_landscape_video_file",
                               id: event_highlight_landscape_video_input_id,
                               accept: "video/mp4,video/quicktime,video/webm",
                               class: "settings-highlight-video-file-input",
                               data: {
                                 homepage_highlight_video_upload_target: "input",
                                 action: "change->homepage-highlight-video-upload#select"
                               } %>
            <label class="button button-secondary button-compact settings-highlight-video-file-button"
                   for="<%= event_highlight_landscape_video_input_id %>">
              Datei auswählen
            </label>
            <span class="settings-highlight-video-file-name"
                  data-homepage-highlight-video-upload-target="fileName">
              <%= event.highlight_landscape_video_file_blob_for_editor.present? ? "Video vorhanden" : "Keine Datei ausgewählt" %>
            </span>
            <button type="button"
                    class="button button-ghost button-compact"
                    data-homepage-highlight-video-upload-target="removeButton"
                    data-action="homepage-highlight-video-upload#remove">
              Entfernen
            </button>
          </div>
          <p class="form-hint" data-homepage-highlight-video-upload-target="status"></p>
        </div>
      </section>
    </div>
  </section>
</div>
