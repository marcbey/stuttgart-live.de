<div class="backend-section-stack">
  <section class="backend-section backend-section-compact editor-subsection" aria-labelledby="promotion-banner-section-title">
    <div class="backend-section-header">
      <h3 id="promotion-banner-section-title">Promotion Banner</h3>
    </div>

    <div class="backend-section-body">
      <label class="form-checkbox form-checkbox-after-textarea">
        <%= hidden_field_tag "blog_post[promotion_banner]", "0", form: form_id, id: nil %>
        <%= check_box_tag "blog_post[promotion_banner]", "1", blog_post.promotion_banner?, form: form_id %>
        <span>Als Promotion Banner markieren</span>
      </label>
      <p class="form-hint">Mehrere Events und News können gleichzeitig als Promotion Banner aktiv sein. Ohne Lane-Position erscheint der Banner nur im Slider oben. Mit Lane-Position erscheint er zusätzlich an der definierten Stelle auf der Startseite. Auf der Startseite wird der Banner nur angezeigt, wenn auch ein Promotion-Banner-Bild vorhanden ist.</p>

      <div class="editor-grid promotion-banner-settings-grid">
        <div>
          <%= label_tag "blog_post_promotion_banner_lane_position", "Lane-Position", class: "form-label" %>
          <%= number_field_tag "blog_post[promotion_banner_lane_position]",
                               blog_post.promotion_banner_lane_position,
                               id: "blog_post_promotion_banner_lane_position",
                               class: "form-input",
                               min: 1,
                               step: 1,
                               form: form_id %>
          <p class="form-hint">Leer bedeutet nur Slider. 1 unter Heute in Stuttgart, 2 unter News, 3 unter Stuttgart im Mix, 4 unter Unter 30€ - Kleine Preise, große Abende.</p>
        </div>

        <div>
          <%= label_tag "blog_post_promotion_banner_kicker_text", "Kicker", class: "form-label" %>
          <%= text_field_tag "blog_post[promotion_banner_kicker_text]",
                             blog_post.promotion_banner_kicker_text_value,
                             id: "blog_post_promotion_banner_kicker_text",
                             class: "form-input",
                             maxlength: 80,
                             form: form_id %>
        </div>

        <div>
          <%= label_tag "blog_post_promotion_banner_title", "Titel", class: "form-label" %>
          <%= text_field_tag "blog_post[promotion_banner_title]",
                             blog_post.promotion_banner_title_value,
                             id: "blog_post_promotion_banner_title",
                             class: "form-input",
                             maxlength: 120,
                             form: form_id %>
        </div>

        <div>
          <%= label_tag "blog_post_promotion_banner_text", "Text", class: "form-label" %>
          <%= text_field_tag "blog_post[promotion_banner_text]",
                             blog_post.promotion_banner_text_value,
                             id: "blog_post_promotion_banner_text",
                             class: "form-input",
                             maxlength: 320,
                             form: form_id %>
        </div>

        <div>
          <label class="form-checkbox form-checkbox-after-textarea">
            <%= hidden_field_tag "blog_post[promotion_banner_slider_text_hidden]", "0", form: form_id, id: nil %>
            <%= check_box_tag "blog_post[promotion_banner_slider_text_hidden]",
                              "1",
                              blog_post.promotion_banner_slider_text_hidden?,
                              id: "blog_post_promotion_banner_slider_text_hidden",
                              form: form_id %>
            <span>Text im Highlight-News-Slider ausblenden</span>
          </label>
          <p class="form-hint">Für News-Bilder, bei denen die Message schon im Motiv steht. Die Promotionbanner im Content behalten ihren Text.</p>
        </div>

        <div>
          <%= label_tag "blog_post_promotion_banner_cta_text", "Button", class: "form-label" %>
          <%= text_field_tag "blog_post[promotion_banner_cta_text]",
                             blog_post.promotion_banner_cta_text_value,
                             id: "blog_post_promotion_banner_cta_text",
                             class: "form-input",
                             maxlength: 80,
                             form: form_id %>
        </div>

        <div data-controller="promotion-banner-color"
             data-promotion-banner-color-default-color-value="<%= blog_post.promotion_banner_background_color_value %>">
          <%= label_tag "blog_post_promotion_banner_background_color", "Hintergrundfarbe", class: "form-label" %>
          <div class="promotion-banner-color-inputs">
            <%= text_field_tag "blog_post[promotion_banner_background_color]",
                               blog_post.promotion_banner_background_color,
                               id: "blog_post_promotion_banner_background_color",
                               class: "form-input",
                               inputmode: "text",
                               maxlength: 7,
                               placeholder: BlogPost::DEFAULT_PROMOTION_BANNER_BACKGROUND_COLOR,
                               form: form_id,
                               data: {
                                 action: "input->promotion-banner-color#syncFromHex blur->promotion-banner-color#normalizeHex",
                                 promotion_banner_color_target: "hex"
                               } %>
            <%= color_field_tag "blog_post_promotion_banner_background_color_picker",
                                blog_post.promotion_banner_background_color_value,
                                id: "blog_post_promotion_banner_background_color_picker",
                                class: "promotion-banner-color-picker",
                                form: form_id,
                                data: {
                                  action: "input->promotion-banner-color#syncFromPicker change->promotion-banner-color#syncFromPicker",
                                  promotion_banner_color_target: "picker"
                                } %>
            <button type="button"
                    class="promotion-banner-color-eyedropper"
                    hidden
                    title="Farbe aus dem Browserfenster aufnehmen"
                    aria-label="Farbe aus dem Browserfenster aufnehmen"
                    data-action="click->promotion-banner-color#pickFromScreen"
                    data-promotion-banner-color-target="eyedropper">
              Pipette
            </button>
          </div>
          <p class="form-hint">Optional. Leer nutzt <%= BlogPost::DEFAULT_PROMOTION_BANNER_BACKGROUND_COLOR %>.</p>
        </div>
      </div>

      <p class="form-hint">Leer gelassene Texte fallen automatisch auf die Standardwerte zurück.</p>

      <%= fields_for :blog_post, blog_post do |form| %>
        <%= render "backend/shared/promotion_banner_image_editor",
                   form: form,
                   form_id: form_id,
                   title: "Promotion-Banner Hochformat",
                   description: "Wird im Highlight-Slider der Startseite verwendet.",
                   section_classes: "blog-post-image-section promotion-banner-image-section",
                   image_blob: blog_post.promotion_banner_image_blob_for_editor,
                   signed_input_name: "blog_post_images[promotion_banner_image_signed_id]",
                   signed_input_value: blog_post.pending_promotion_banner_image_blob&.signed_id,
                   remove_input_name: "blog_post_images[remove_promotion_banner_image]",
                   remove_value: (blog_post.remove_promotion_banner_image? ? "1" : "0"),
                   upload_input_id: "#{form_id}_promotion_banner_image_upload",
                   copyright_attribute: :promotion_banner_image_copyright,
                   copyright_value: blog_post.promotion_banner_image_copyright,
                   focus_x_attribute: :promotion_banner_image_focus_x,
                   focus_y_attribute: :promotion_banner_image_focus_y,
                   zoom_attribute: :promotion_banner_image_zoom,
                   focus_x_value: blog_post.promotion_banner_image_focus_x_value,
                   focus_y_value: blog_post.promotion_banner_image_focus_y_value,
                   zoom_value: blog_post.promotion_banner_image_zoom_value,
                   image_alt: "#{blog_post.title} Promotion Banner",
                   preview_variant: "promotion-banner" %>

        <%= render "backend/shared/promotion_banner_image_editor",
                   form: form,
                   form_id: form_id,
                   title: "Promotion-Banner Querformat",
                   description: "Optionales Querformat für die breiten Promotionbanner im Content. Wenn nichts gepflegt ist, wird das Hochformat-Bild genutzt.",
                   section_classes: "blog-post-image-section promotion-banner-image-section",
                   image_blob: blog_post.promotion_banner_landscape_image_blob_for_editor,
                   signed_input_name: "blog_post_images[promotion_banner_landscape_image_signed_id]",
                   signed_input_value: blog_post.pending_promotion_banner_landscape_image_blob&.signed_id,
                   remove_input_name: "blog_post_images[remove_promotion_banner_landscape_image]",
                   remove_value: (blog_post.remove_promotion_banner_landscape_image? ? "1" : "0"),
                   upload_input_id: "#{form_id}_promotion_banner_landscape_image_upload",
                   copyright_attribute: :promotion_banner_landscape_image_copyright,
                   copyright_value: blog_post.promotion_banner_landscape_image_copyright,
                   focus_x_attribute: :promotion_banner_landscape_image_focus_x,
                   focus_y_attribute: :promotion_banner_landscape_image_focus_y,
                   zoom_attribute: :promotion_banner_landscape_image_zoom,
                   focus_x_value: blog_post.promotion_banner_landscape_image_focus_x_value,
                   focus_y_value: blog_post.promotion_banner_landscape_image_focus_y_value,
                   zoom_value: blog_post.promotion_banner_landscape_image_zoom_value,
                   image_alt: "#{blog_post.title} Promotion Banner Querformat",
                   preview_variant: "2x1" %>
      <% end %>
    </div>
  </section>
</div>
