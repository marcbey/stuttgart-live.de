#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANSIBLE_DIR="$ROOT_DIR/infra/ansible"
INVENTORY="$ANSIBLE_DIR/inventories/production/hosts.yml"
PLAYBOOK="$ANSIBLE_DIR/playbooks/app_host.yml"
SSH_KEY="${SSH_KEY:-$HOME/.ssh/stgt-live-hetzner-admin}"
SSH_USER="${SSH_USER:-admin}"

read_dotenv_value() {
  local key="$1"
  local dotenv_file="$ROOT_DIR/.env"
  local line name value

  [[ -f "$dotenv_file" ]] || return 1

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" || "${line:0:1}" == "#" ]] && continue

    line="${line#export }"
    name="${line%%=*}"
    value="${line#*=}"
    [[ "$name" == "$key" ]] || continue

    value="${value%$'\r'}"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
    printf '%s\n' "$value"
    return 0
  done < "$dotenv_file"

  return 1
}

# Host-Setup und App-Deploy müssen dasselbe DB-Passwort verwenden.
# Das Skript zieht den Wert daher direkt aus der lokalen `.env`.
db_password="$(read_dotenv_value DB_PASSWORD || true)"
if [[ -z "$db_password" ]]; then
  printf 'DB_PASSWORD fehlt in .env\n' >&2
  exit 1
fi

extra_vars=( "-e" "postgres_app_password=$db_password" )

russ_live_readonly_password="$(read_dotenv_value RUSS_LIVE_PRIMARY_DB_PASSWORD || true)"
russ_live_operational_password="$(read_dotenv_value RUSS_LIVE_OPERATIONAL_DB_PASSWORD || true)"

if [[ -n "$russ_live_readonly_password" || -n "$russ_live_operational_password" ]]; then
  if [[ -z "$russ_live_readonly_password" || -z "$russ_live_operational_password" ]]; then
    printf 'RUSS_LIVE_PRIMARY_DB_PASSWORD und RUSS_LIVE_OPERATIONAL_DB_PASSWORD müssen gemeinsam gesetzt sein.\n' >&2
    exit 1
  fi

  extra_vars+=( "-e" "postgres_russ_live_readonly_password=$russ_live_readonly_password" )
  extra_vars+=( "-e" "postgres_russ_live_operational_password=$russ_live_operational_password" )
fi

cd "$ANSIBLE_DIR"
# Zusätzliche CLI-Argumente werden unverändert an ansible-playbook weitergereicht.
exec ansible-playbook \
  -i "$INVENTORY" \
  -u "$SSH_USER" \
  --private-key "$SSH_KEY" \
  "$PLAYBOOK" \
  "${extra_vars[@]}" \
  "$@"
